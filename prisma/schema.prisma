generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                         String                   @id @default(cuid())
  name                       String
  startDate                  DateTime
  endDate                    DateTime
  status                     EventStatus              @default(DRAFT)
  archived                   Boolean                  @default(false)
  guestCount                 Int?
  isLegacy                   Boolean                  @default(false)
  isDemo                     Boolean                  @default(false)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  occasionType               OccasionType?
  occasionDescription        String?
  hostId                     String
  coHostId                   String?
  guestCountConfidence       GuestCountConfidence     @default(MEDIUM)
  guestCountMin              Int?
  guestCountMax              Int?
  dietaryStatus              DietaryStatus            @default(UNSPECIFIED)
  dietaryVegetarian          Int                      @default(0)
  dietaryVegan               Int                      @default(0)
  dietaryGlutenFree          Int                      @default(0)
  dietaryDairyFree           Int                      @default(0)
  dietaryAllergies           String?
  venueName                  String?
  venueType                  VenueType?
  venueKitchenAccess         KitchenAccess?
  venueOvenCount             Int                      @default(0)
  venueStoretopBurners       Int?
  venueBbqAvailable          Boolean?
  venueTimingStart           String?
  venueTimingEnd             String?
  venueNotes                 String?
  generationPath             GenerationPath?
  clonedFromId               String?
  cloneAdaptations           Json?
  checkPlanInvocations       Int                      @default(0)
  firstCheckPlanAt           DateTime?
  lastCheckPlanAt            DateTime?
  checkPlanBeforeGate        Boolean                  @default(false)
  transitionAttempts         Json?
  transitionedToConfirmingAt DateTime?
  planSnapshotIdAtConfirming String?
  structureMode              StructureMode            @default(EDITABLE)
  blindAccept                Boolean                  @default(false)
  madeAnyEditBeforeCheckPlan Boolean                  @default(false)
  manualAdditionsCount       Int                      @default(0)
  hostReadinessConfidence    HostReadinessConfidence?
  currentRevisionId          String?
  inviteSendConfirmedAt      DateTime?
  sharedLinkToken            String?                  @unique
  sharedLinkEnabled          Boolean                  @default(false)
  frozenAt                   DateTime?
  complianceAtFreeze         Float?
  freezeReason               String?
  stripePaymentIntentId      String?                  @unique
  paidAt                     DateTime?
  amountPaid                 Int?
  tokens                     AccessToken[]
  acknowledgements           Acknowledgement[]
  auditLog                   AuditEntry[]
  conflicts                  Conflict[]
  days                       Day[]
  clonedFrom                 Event?                   @relation("EventClone", fields: [clonedFromId], references: [id])
  clonedEvents               Event[]                  @relation("EventClone")
  coHost                     Person?                  @relation("EventCoHost", fields: [coHostId], references: [id])
  currentRevision            PlanRevision?            @relation("EventCurrentRevision", fields: [currentRevisionId], references: [id])
  host                       Person                   @relation("EventHost", fields: [hostId], references: [id])
  planSnapshotAtConfirming   PlanSnapshot?            @relation("EventConfirmingSnapshot", fields: [planSnapshotIdAtConfirming], references: [id])
  eventRoles                 EventRole[]
  households                 Household[]
  inviteEvents               InviteEvent[]
  people                     PersonEvent[]
  revisions                  PlanRevision[]
  snapshots                  PlanSnapshot[]
  structureChanges           StructureChangeRequest[]
  teams                      Team[]
}

model Day {
  id      String   @id @default(cuid())
  name    String
  date    DateTime
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   Item[]
}

model Team {
  id               String           @id @default(cuid())
  name             String
  scope            String?
  domain           Domain?
  domainConfidence DomainConfidence @default(MEDIUM)
  displayOrder     Int              @default(0)
  source           ItemSource       @default(MANUAL)
  isProtected      Boolean          @default(false)
  eventId          String
  coordinatorId    String?
  tokens           AccessToken[]
  items            Item[]
  members          PersonEvent[]
  coordinator      Person?          @relation("TeamCoordinator", fields: [coordinatorId], references: [id])
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Person {
  id               String        @id @default(cuid())
  name             String
  email            String?       @unique
  phone            String?
  userId           String?
  phoneNumber      String?
  smsOptedOut      Boolean       @default(false)
  smsOptedOutAt    DateTime?
  inviteAnchorAt   DateTime?
  nudge24hSentAt   DateTime?
  nudge48hSentAt   DateTime?
  tokens           AccessToken[]
  assignments      Assignment[]
  auditActions     AuditEntry[]
  cohostedEvents   Event[]       @relation("EventCoHost")
  hostedEvents     Event[]       @relation("EventHost")
  hostMemory       HostMemory?
  households       Household[]
  inviteEvents     InviteEvent[]
  user             User?         @relation(fields: [userId], references: [id])
  eventMemberships PersonEvent[]
  receivedOptOuts  SmsOptOut[]   @relation("HostOptOuts")
  coordinatedTeams Team[]        @relation("TeamCoordinator")

  @@index([userId])
  @@index([email])
}

model PersonEvent {
  id                   String           @id @default(cuid())
  personId             String
  eventId              String
  teamId               String?
  role                 PersonRole       @default(PARTICIPANT)
  reachabilityTier     ReachabilityTier @default(UNTRACKABLE)
  contactMethod        ContactMethod    @default(NONE)
  claimedViaSharedLink Boolean          @default(false)
  proxyPersonEventId   String?
  rsvpStatus           RsvpStatus       @default(PENDING)
  rsvpRespondedAt      DateTime?
  rsvpFollowupSentAt   DateTime?
  householdMember      HouseholdMember?
  event                Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person               Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  proxy                PersonEvent?     @relation("ProxyRelation", fields: [proxyPersonEventId], references: [id])
  householdMembers     PersonEvent[]    @relation("ProxyRelation")
  team                 Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([personId, eventId])
}

model Household {
  id            String            @id @default(cuid())
  eventId       String
  proxyPersonId String
  name          String?
  createdAt     DateTime          @default(now())
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proxyPerson   Person            @relation(fields: [proxyPersonId], references: [id])
  members       HouseholdMember[]

  @@unique([eventId, proxyPersonId])
}

model HouseholdMember {
  id               String       @id @default(cuid())
  householdId      String
  name             String
  claimedAt        DateTime?
  personEventId    String?      @unique
  proxyNudgeCount  Int          @default(0)
  lastProxyNudgeAt DateTime?
  escalatedAt      DateTime?
  household        Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  personEvent      PersonEvent? @relation(fields: [personEventId], references: [id])
}

model Item {
  id                          String              @id @default(cuid())
  name                        String
  quantity                    String?
  description                 String?
  critical                    Boolean             @default(false)
  status                      ItemStatus          @default(UNASSIGNED)
  previouslyAssignedTo        String?
  quantityAmount              Float?
  quantityUnit                QuantityUnit?
  quantityUnitCustom          String?
  quantityText                String?
  quantityState               QuantityState       @default(SPECIFIED)
  quantityLabel               QuantityLabel?
  quantitySource              QuantitySource?
  quantityDerivedFromTemplate Boolean             @default(false)
  placeholderAcknowledged     Boolean             @default(false)
  quantityDeferredTo          QuantityDeferredTo?
  criticalReason              String?
  criticalSource              CriticalSource?
  criticalOverride            CriticalOverride    @default(NONE)
  glutenFree                  Boolean             @default(false)
  dairyFree                   Boolean             @default(false)
  vegetarian                  Boolean             @default(false)
  dietaryTags                 Json?
  equipmentNeeds              Json?
  equipmentLoad               Float?
  durationMinutes             Int?
  notes                       String?
  prepStartTime               String?
  prepEndTime                 String?
  serveTime                   String?
  dropOffAt                   DateTime?
  dropOffLocation             String?
  dropOffNote                 String?
  source                      ItemSource          @default(MANUAL)
  generatedBatchId            String?
  isProtected                 Boolean             @default(false)
  lastEditedBy                LastEditedBy?
  aiGenerated                 Boolean             @default(false)
  userConfirmed               Boolean             @default(false)
  teamId                      String
  dayId                       String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  assignment                  Assignment?
  day                         Day?                @relation(fields: [dayId], references: [id])
  team                        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Assignment {
  id        String             @id @default(cuid())
  response  AssignmentResponse @default(PENDING)
  createdAt DateTime           @default(now())
  itemId    String             @unique
  personId  String
  item      Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person    Person             @relation(fields: [personId], references: [id])
}

model InviteEvent {
  id        String          @id @default(cuid())
  eventId   String
  personId  String?
  type      InviteEventType
  metadata  Json?
  createdAt DateTime        @default(now())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person?         @relation(fields: [personId], references: [id])

  @@index([eventId])
  @@index([personId])
  @@index([type])
  @@index([createdAt])
}

model SmsOptOut {
  id          String   @id @default(cuid())
  phoneNumber String
  hostId      String
  optedOutAt  DateTime @default(now())
  rawMessage  String?
  host        Person   @relation("HostOptOuts", fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([phoneNumber, hostId])
  @@index([phoneNumber])
  @@index([hostId])
}

model AccessToken {
  id        String     @id @default(cuid())
  token     String     @unique
  scope     TokenScope
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  eventId   String
  personId  String
  teamId    String?
  openedAt  DateTime?
  claimedAt DateTime?
  claimedBy String?
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  team      Team?      @relation(fields: [teamId], references: [id])

  @@unique([eventId, personId, scope, teamId])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  billingStatus BillingStatus @default(FREE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  eventRoles    EventRole[]
  people        Person[]
  sessions      Session[]
  subscription  Subscription?

  @@index([email])
}

model Subscription {
  id                   String        @id @default(cuid())
  userId               String        @unique
  stripeCustomerId     String        @unique
  stripeSubscriptionId String?       @unique
  stripePriceId        String?
  status               BillingStatus @default(FREE)
  statusChangedAt      DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@index([expiresAt])
}

model EventRole {
  id        String        @id @default(cuid())
  userId    String
  eventId   String
  role      EventRoleType
  createdAt DateTime      @default(now())
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model AuditEntry {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actionType String
  targetType String
  targetId   String
  details    String?
  eventId    String
  actorId    String
  actor      Person   @relation(fields: [actorId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Conflict {
  id                      String            @id @default(cuid())
  eventId                 String
  fingerprint             String
  type                    ConflictType
  severity                ConflictSeverity
  claimType               ClaimType
  resolutionClass         ResolutionClass
  title                   String
  description             String
  affectedItems           Json?
  affectedDays            Json?
  affectedParties         Json?
  equipment               String?
  timeSlot                String?
  capacityAvailable       Float?
  capacityRequired        Float?
  dietaryType             String?
  guestCount              Int?
  category                String?
  currentCoverage         Int?
  minimumNeeded           Int?
  suggestion              Json?
  inputsReferenced        Json?
  status                  ConflictStatus    @default(OPEN)
  viewed                  Boolean           @default(false)
  viewDuration            Int               @default(0)
  whyThisViewed           Boolean           @default(false)
  dismissedWithoutReading Boolean           @default(false)
  resolvedBy              String?
  resolvedAt              DateTime?
  dismissedAt             DateTime?
  delegatedTo             DelegatedTo?
  delegatedAt             DateTime?
  canDelegate             Boolean           @default(false)
  delegateToRoles         Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  acknowledgements        Acknowledgement[]
  event                   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([fingerprint])
}

model Acknowledgement {
  id                          String                 @id @default(cuid())
  conflictId                  String
  eventId                     String
  acknowledgedAt              DateTime
  acknowledgedBy              String
  impactStatement             String
  impactUnderstood            Boolean
  mitigationPlanType          MitigationPlanType
  affectedParties             Json?
  alternativesConsidered      AlternativesConsidered @default(NONE)
  visibilityCohosts           Boolean                @default(true)
  visibilityCoordinators      String                 @default("NONE")
  visibilityParticipants      Boolean                @default(false)
  supersedesAcknowledgementId String?
  status                      AcknowledgementStatus  @default(ACTIVE)
  createdAt                   DateTime               @default(now())
  conflict                    Conflict               @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  event                       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([conflictId])
}

model PlanRevision {
  id               String   @id @default(cuid())
  eventId          String
  revisionNumber   Int
  teams            Json
  items            Json
  days             Json
  conflicts        Json
  acknowledgements Json
  createdAt        DateTime
  createdBy        String
  reason           String?
  currentForEvents Event[]  @relation("EventCurrentRevision")
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model PlanSnapshot {
  id               String        @id @default(cuid())
  eventId          String
  phase            SnapshotPhase
  teams            Json
  items            Json
  days             Json
  criticalFlags    Json
  acknowledgements Json
  createdAt        DateTime      @default(now())
  confirmingEvents Event[]       @relation("EventConfirmingSnapshot")
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model StructureChangeRequest {
  id                    String                @id @default(cuid())
  eventId               String
  type                  StructureChangeType
  requestedBy           String
  requestedAt           DateTime
  reason                String
  impactedCoordinators  Json?
  impactedItems         Json?
  deltaFromSnapshot     Json?
  status                StructureChangeStatus @default(PENDING)
  appliedAt             DateTime?
  previousCriticalState Boolean?
  newCriticalState      Boolean?
  event                 Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
}

model StructureTemplate {
  id               String         @id @default(cuid())
  hostId           String
  templateSource   TemplateSource
  name             String
  occasionType     String
  teams            Json
  items            Json
  days             Json
  version          String?
  changelogSummary String?
  publishedAt      DateTime?
  createdFrom      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([hostId])
  @@index([templateSource])
}

model QuantitiesProfile {
  id             String   @id @default(cuid())
  hostId         String
  occasionType   String
  derivedFrom    Json
  ratios         Json
  itemQuantities Json
  overrides      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hostId, occasionType])
}

model HostMemory {
  id                           String                @id @default(cuid())
  hostId                       String                @unique
  learningEnabled              Boolean               @default(false)
  aggregateContributionConsent Boolean               @default(false)
  useHistoryByDefault          Boolean               @default(false)
  updatedAt                    DateTime              @updatedAt
  dismissedSuggestions         DismissedSuggestion[]
  defaults                     HostDefault[]
  host                         Person                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  patterns                     HostPattern[]
}

model HostPattern {
  id           String            @id @default(cuid())
  hostMemoryId String
  occasionType String
  patternType  PatternType
  patternData  Json
  derivedFrom  Json
  confidence   PatternConfidence
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  hostMemory   HostMemory        @relation(fields: [hostMemoryId], references: [id], onDelete: Cascade)

  @@index([hostMemoryId])
}

model HostDefault {
  id           String     @id @default(cuid())
  hostMemoryId String
  field        String
  value        Json
  setAt        DateTime
  hostMemory   HostMemory @relation(fields: [hostMemoryId], references: [id], onDelete: Cascade)

  @@index([hostMemoryId])
}

model DismissedSuggestion {
  id             String     @id @default(cuid())
  hostMemoryId   String
  suggestionType String
  dismissedAt    DateTime
  count          Int
  hostMemory     HostMemory @relation(fields: [hostMemoryId], references: [id], onDelete: Cascade)

  @@index([hostMemoryId])
}

model DeletionReceipt {
  id                          String        @id @default(cuid())
  hostId                      String
  deletedAt                   DateTime
  scope                       DeletionScope
  targetIds                   Json?
  derivedArtifactsRemoved     Boolean
  aggregateContributionPurged Boolean
}

enum PersonRole {
  HOST
  COORDINATOR
  PARTICIPANT
}

enum ReachabilityTier {
  DIRECT
  PROXY
  SHARED
  UNTRACKABLE
}

enum ContactMethod {
  EMAIL
  SMS
  NONE
}

enum EventRoleType {
  HOST
  COHOST
  COORDINATOR
}

enum ItemStatus {
  ASSIGNED
  UNASSIGNED
}

enum TokenScope {
  HOST
  COORDINATOR
  PARTICIPANT
}

enum BillingStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EventStatus {
  DRAFT
  CONFIRMING
  FROZEN
  COMPLETE
}

enum OccasionType {
  CHRISTMAS
  THANKSGIVING
  EASTER
  WEDDING
  BIRTHDAY
  REUNION
  RETREAT
  OTHER
}

enum GuestCountConfidence {
  HIGH
  MEDIUM
  LOW
}

enum DietaryStatus {
  UNSPECIFIED
  NONE
  SPECIFIED
}

enum VenueType {
  HOME
  HIRED_VENUE
  OUTDOOR
  MIXED
  OTHER
}

enum KitchenAccess {
  FULL
  LIMITED
  NONE
  CATERING_ONLY
}

enum GenerationPath {
  AI
  TEMPLATE
  MANUAL
}

enum StructureMode {
  EDITABLE
  LOCKED
  CHANGE_REQUESTED
}

enum HostReadinessConfidence {
  HIGH
  MEDIUM
  LOW
}

enum Domain {
  PROTEINS
  VEGETARIAN_MAINS
  SIDES
  SALADS
  STARTERS
  DESSERTS
  DRINKS
  LATER_FOOD
  SETUP
  CLEANUP
  CUSTOM
}

enum DomainConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ItemSource {
  GENERATED
  TEMPLATE
  MANUAL
  HOST_EDITED
}

enum QuantityUnit {
  KG
  G
  L
  ML
  COUNT
  PACKS
  TRAYS
  SERVINGS
  CUSTOM
}

enum QuantityState {
  SPECIFIED
  PLACEHOLDER
  NA
}

enum QuantityLabel {
  CALCULATED
  HEURISTIC
  PLACEHOLDER
}

enum QuantitySource {
  HOST_INPUTS
  HOST_HISTORY
  HOST_DEFAULTS
  SYSTEM_HEURISTICS
  AGGREGATE_PATTERNS
  TEMPLATE
}

enum QuantityDeferredTo {
  COORDINATOR
}

enum CriticalSource {
  AI
  HOST
  RULE
}

enum CriticalOverride {
  NONE
  ADDED
  REMOVED
}

enum LastEditedBy {
  AI
  HOST
}

enum ConflictType {
  TIMING
  DIETARY_GAP
  STRUCTURAL_IMBALANCE
  CONSTRAINT_VIOLATION
  COVERAGE_GAP
  QUANTITY_MISSING
  EQUIPMENT_MISMATCH
}

enum ConflictSeverity {
  CRITICAL
  SIGNIFICANT
  ADVISORY
}

enum ClaimType {
  CONSTRAINT
  RISK
  PATTERN
  PREFERENCE
  ASSUMPTION
}

enum ResolutionClass {
  FIX_IN_PLAN
  DECISION_REQUIRED
  DELEGATE_ALLOWED
  INFORMATIONAL
}

enum ConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
  ACKNOWLEDGED
  DELEGATED
}

enum DelegatedTo {
  COORDINATOR
}

enum MitigationPlanType {
  SUBSTITUTE
  REASSIGN
  COMMUNICATE
  ACCEPT_GAP
  EXTERNAL_CATERING
  BRING_OWN
  OTHER
}

enum AlternativesConsidered {
  NONE
  REVIEWED
  ATTEMPTED
}

enum AcknowledgementStatus {
  ACTIVE
  SUPERSEDED
}

enum SnapshotPhase {
  CONFIRMING
}

enum StructureChangeType {
  ADD_TEAM
  RENAME_TEAM
  REMOVE_TEAM
  MOVE_ITEM_TEAM
  ADD_ITEM_TO_TEAM
  REMOVE_ITEM
  CHANGE_CRITICAL_FLAG
}

enum StructureChangeStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum TemplateSource {
  HOST
  GATHER_CURATED
}

enum PatternType {
  TEAM_STRUCTURE
  DOMAIN_COVERAGE
  QUANTITY_RATIO
  CRITICAL_ITEMS
}

enum PatternConfidence {
  HIGH
  MEDIUM
  LOW
}

enum DeletionScope {
  ALL
  EVENTS
  PATTERNS
  SPECIFIC_EVENT
}

enum AssignmentResponse {
  PENDING
  ACCEPTED
  DECLINED
}

enum RsvpStatus {
  PENDING
  YES
  NO
  NOT_SURE
}

enum InviteEventType {
  INVITE_SEND_CONFIRMED
  LINK_OPENED
  NAME_CLAIMED
  RESPONSE_SUBMITTED
  NUDGE_SENT_AUTO
  NUDGE_DEFERRED_QUIET
  PROXY_NUDGE_SENT
  PROXY_NUDGE_DEFERRED_QUIET
  HOUSEHOLD_ESCALATED
  SMS_OPT_OUT_RECEIVED
  SMS_BLOCKED_OPT_OUT
  SMS_BLOCKED_INVALID
  SMS_SEND_FAILED
  MANUAL_OVERRIDE_MARKED
  CLAIM_RESET
  NUDGE_SENT_HOST
}
