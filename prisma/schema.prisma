model WrapUpLink {
  id           String    @id @default(cuid())
  token        String    @unique
  eventId      String
  personId     String
  guestName    String
  guestEmail   String?
  guestPhone   String?
  channel      String
  dispatched   Boolean   @default(false)
  dispatchedAt DateTime?
  failed       Boolean   @default(false)
  failReason   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  event        Event     @relation(fields: [eventId], references: [id])
  person       Person    @relation(fields: [personId], references: [id])

  @@index([eventId])
  @@index([token])
  @@index([dispatched, createdAt])
}

model NudgeLog {
  id            String      @id @default(cuid())
  personEventId String
  nudgeType     String
  scheduledFor  DateTime
  sentAt        DateTime?
  status        String
  errorMessage  String?
  createdAt     DateTime    @default(now())
  personEvent   PersonEvent @relation(fields: [personEventId], references: [id], onDelete: Cascade)
}

model EventSetup {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  eventType      String?
  eventTypeOther String?

  mainsData              Json?
  sidesData              Json?
  dessertsData           Json?
  drinksData             Json?
  setupCleanupData       Json?
  dietaryData            Json?
  otherNotes             String?
  // GTC-133 sub-commit (d): Other-jobs section accordions. Each is a free-text + stillDeciding shape.
  // Shape: { freeText: string, stillDeciding: boolean }
  setUpData              Json?
  cleanUpData            Json?
  otherJobsOtherData     Json?
  // GTC-133: keyed by config category (entree_starters, drinks_alcoholic, etc.) for the 9 categories
  // without dedicated columns. Shape: { [categoryKey]: { selections: OptionTreeSelections, stillDeciding?: boolean } }
  extendedCategoriesData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
