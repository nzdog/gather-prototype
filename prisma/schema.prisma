generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                         String                   @id @default(cuid())
  name                       String
  startDate                  DateTime
  endDate                    DateTime
  status                     EventStatus              @default(DRAFT)
  archived                   Boolean                  @default(false)
  guestCount                 Int?
  isLegacy                   Boolean                  @default(false)
  isDemo                     Boolean                  @default(false)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  occasionType               OccasionType?
  occasionDescription        String?
  hostId                     String
  coHostId                   String?
  guestCountConfidence       GuestCountConfidence     @default(MEDIUM)
  guestCountMin              Int?
  guestCountMax              Int?
  dietaryStatus              DietaryStatus            @default(UNSPECIFIED)
  dietaryVegetarian          Int                      @default(0)
  dietaryVegan               Int                      @default(0)
  dietaryGlutenFree          Int                      @default(0)
  dietaryDairyFree           Int                      @default(0)
  dietaryAllergies           String?
  venueName                  String?
  venueType                  VenueType?
  venueKitchenAccess         KitchenAccess?
  venueOvenCount             Int                      @default(0)
  venueStoretopBurners       Int?
  venueBbqAvailable          Boolean?
  venueTimingStart           String?
  venueTimingEnd             String?
  venueNotes                 String?
  generationPath             GenerationPath?
  clonedFromId               String?
  cloneAdaptations           Json?
  checkPlanInvocations       Int                      @default(0)
  firstCheckPlanAt           DateTime?
  lastCheckPlanAt            DateTime?
  checkPlanBeforeGate        Boolean                  @default(false)
  transitionAttempts         Json?
  transitionedToConfirmingAt DateTime?
  planSnapshotIdAtConfirming String?
  structureMode              StructureMode            @default(EDITABLE)
  blindAccept                Boolean                  @default(false)
  madeAnyEditBeforeCheckPlan Boolean                  @default(false)
  manualAdditionsCount       Int                      @default(0)
  hostReadinessConfidence    HostReadinessConfidence?
  currentRevisionId          String?
  // GTC-168 (A2): THE SEND. Renamed from inviteSendConfirmedAt — this field already
  // was the send (it anchors the nudge machinery and fires before freezing), so the
  // rename is Prisma-level only via @map: the column keeps its name and its data, and
  // no SQL runs. The physical column rename is deferred to GTC-199 (A4), which already
  // requires a backup. See send-lock-reconciliation-plan.md §0.1, §2.
  sentAt                     DateTime?                @map("inviteSendConfirmedAt")
  sharedLinkToken            String?                  @unique
  sharedLinkEnabled          Boolean                  @default(false)
  // Retained, unwritten after GTC-169 (A3a). Historical evidence of the old freeze
  // ceremony. Dropped by GTC-199 (A4).
  frozenAt                   DateTime?
  complianceAtFreeze         Float?
  freezeReason               String?
  wrappedAt                  DateTime?
  stripePaymentIntentId      String?                  @unique
  paidAt                     DateTime?
  amountPaid                 Int?
  tokens                     AccessToken[]
  acknowledgements           Acknowledgement[]
  auditLog                   AuditEntry[]
  conflicts                  Conflict[]
  days                       Day[]
  clonedFrom                 Event?                   @relation("EventClone", fields: [clonedFromId], references: [id])
  clonedEvents               Event[]                  @relation("EventClone")
  coHost                     Person?                  @relation("EventCoHost", fields: [coHostId], references: [id])
  currentRevision            PlanRevision?            @relation("EventCurrentRevision", fields: [currentRevisionId], references: [id])
  host                       Person                   @relation("EventHost", fields: [hostId], references: [id])
  planSnapshotAtConfirming   PlanSnapshot?            @relation("EventConfirmingSnapshot", fields: [planSnapshotIdAtConfirming], references: [id])
  eventRoles                 EventRole[]
  households                 Household[]
  inviteEvents               InviteEvent[]
  people                     PersonEvent[]
  revisions                  PlanRevision[]
  snapshots                  PlanSnapshot[]
  teams                      Team[]
  aiCallsUsed                Int                      @default(0)
  wrapUpLinks                WrapUpLink[]
  setup                      EventSetup?
}

model Day {
  id      String   @id @default(cuid())
  name    String
  date    DateTime
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   Item[]
}

model Team {
  id               String           @id @default(cuid())
  name             String
  scope            String?
  domain           Domain?
  domainConfidence DomainConfidence @default(MEDIUM)
  displayOrder     Int              @default(0)
  source           ItemSource       @default(MANUAL)
  isProtected      Boolean          @default(false)
  eventId          String
  coordinatorId    String?
  tokens           AccessToken[]
  items            Item[]
  members          PersonEvent[]
  coordinator      Person?          @relation("TeamCoordinator", fields: [coordinatorId], references: [id])
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Person {
  id               String        @id @default(cuid())
  name             String
  email            String?       @unique
  phone            String?
  userId           String?
  phoneNumber      String?
  smsOptedOut      Boolean       @default(false)
  smsOptedOutAt    DateTime?
  inviteAnchorAt   DateTime?
  nudge24hSentAt   DateTime?
  nudge48hSentAt   DateTime?
  tokens           AccessToken[]
  assignments      Assignment[]
  auditActions     AuditEntry[]
  cohostedEvents   Event[]       @relation("EventCoHost")
  hostedEvents     Event[]       @relation("EventHost")
  hostMemory       HostMemory?
  inviteEvents     InviteEvent[]
  user             User?         @relation(fields: [userId], references: [id])
  eventMemberships PersonEvent[]
  receivedOptOuts  SmsOptOut[]   @relation("HostOptOuts")
  coordinatedTeams Team[]        @relation("TeamCoordinator")
  wrapUpLinks      WrapUpLink[]

  @@index([userId])
  @@index([email])
}

model PersonEvent {
  id                   String           @id @default(cuid())
  personId             String
  eventId              String
  teamId               String?
  role                 PersonRole       @default(PARTICIPANT)
  reachabilityTier     ReachabilityTier @default(UNTRACKABLE)
  contactMethod        ContactMethod    @default(NONE)
  claimedViaSharedLink Boolean          @default(false)
  proxyPersonEventId   String?
  rsvpStatus           RsvpStatus       @default(PENDING)
  rsvpRespondedAt      DateTime?
  rsvpFollowupSentAt   DateTime?
  /// GTC-168 (A2): THIS person's send clock — the mini-send anchor (Hinge §2, gap #5).
  /// Set to Event.sentAt at the press; set to now() for anyone added afterwards, so
  /// their nudge cadence and red-by-time run from THEIR send date, truncated by the
  /// event date. isMiniSend = PersonEvent.sentAt > Event.sentAt — no extra field.
  ///
  /// Replaces Person.inviteAnchorAt, which holds the same value on the WRONG MODEL:
  /// Person is global, so a person in two events shares one anchor and the second
  /// event's clocks are wrong from the start (the guard at people/route.ts:133 only
  /// sets it when null). Person.inviteAnchorAt is retained-but-unwritten until
  /// GTC-199 (A4). Person.nudge24hSentAt/nudge48hSentAt carry the identical leak and
  /// move under GTC-178 (E1) — zone-7-adjacent, not this ticket's.
  sentAt               DateTime?
  householdId          String?
  household            Household?       @relation("HouseholdMembers", fields: [householdId], references: [id])
  householdRole        HouseholdRole?
  /// GTC-172 (C1): DISPLAY ONLY — "captured as a kid with a job". This is NEVER an
  /// input to message eligibility; `householdRole` is the sole gate (Moment 4 §10.6,
  /// absolute). It exists so a young person Kate has DELIBERATELY roled as an adult
  /// still renders in her helpers list instead of silently jumping to the guests list
  /// on reload. Setting this true never grants messageability, and setting it false
  /// never removes it — read it for layout, never for a send decision.
  isYoungPerson        Boolean          @default(false)
  event                Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person               Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  proxy                PersonEvent?     @relation("ProxyRelation", fields: [proxyPersonEventId], references: [id])
  householdMembers     PersonEvent[]    @relation("ProxyRelation")
  team                 Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  nudgeLogs NudgeLog[]

  /// GTC-172 (C1): back-relation for Household.contactPersonEvent — the households
  /// that have picked THIS PersonEvent as their channel. Cross-household by design:
  /// these households need not be this row's own `household`.
  householdsAsContact Household[] @relation("HouseholdContactChannel")

  @@unique([personId, eventId])
}

model Household {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     PersonEvent[] @relation("HouseholdMembers")
  littleCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// GTC-172 (C1): the household contact picker — Moment 4 §10.7. "Who should Gather
  /// talk to for this household?" A reference, never a boolean, and CROSS-HOUSEHOLD
  /// CAPABLE: this may point at a PersonEvent belonging to a DIFFERENT household of
  /// the same event (Grandma's channel lives in her daughter's household).
  ///
  /// NULL means "not picked" and resolves to the household's PRIMARY_CONTACT at read
  /// time — see resolveHouseholdChannel() in src/lib/households/channel.ts. That is
  /// why this ships with no data backfill: the default is computed, not stored.
  ///
  /// A CHILD-role PersonEvent must never be stored here (§10.6). The picker omits
  /// them and the API rejects them, but the eligibility layer re-checks anyway rather
  /// than trusting either.
  contactPersonEventId String?
  contactPersonEvent   PersonEvent? @relation("HouseholdContactChannel", fields: [contactPersonEventId], references: [id], onDelete: SetNull)

  @@index([contactPersonEventId])
}

model Item {
  id                          String              @id @default(cuid())
  name                        String
  /// GTC-171 (B2): the row-kind discriminator. Moment 4 spec §6 — "one assignment
  /// machine, two kinds of rows" (items are owed *to* the day; tasks are owed
  /// *during* it). Task rows are Item rows, so `Assignment` reaches both through
  /// the identical relation, unchanged.
  kind                        RowKind             @default(ITEM)
  quantity                    String?
  description                 String?
  critical                    Boolean             @default(false)
  status                      ItemStatus          @default(UNASSIGNED)
  previouslyAssignedTo        String?
  quantityAmount              Float?
  quantityUnit                QuantityUnit?
  quantityUnitCustom          String?
  quantityText                String?
  quantityState               QuantityState       @default(SPECIFIED)
  quantityLabel               QuantityLabel?
  quantitySource              QuantitySource?
  quantityDerivedFromTemplate Boolean             @default(false)
  placeholderAcknowledged     Boolean             @default(false)
  quantityDeferredTo          QuantityDeferredTo?
  criticalReason              String?
  criticalSource              CriticalSource?
  criticalOverride            CriticalOverride    @default(NONE)
  glutenFree                  Boolean             @default(false)
  dairyFree                   Boolean             @default(false)
  vegetarian                  Boolean             @default(false)
  dietaryTags                 Json?
  equipmentNeeds              Json?
  equipmentLoad               Float?
  durationMinutes             Int?
  notes                       String?
  prepStartTime               String?
  prepEndTime                 String?
  serveTime                   String?
  dropOffAt                   DateTime?
  dropOffLocation             String?
  dropOffNote                 String?
  source                      ItemSource          @default(MANUAL)
  generatedBatchId            String?
  isProtected                 Boolean             @default(false)
  lastEditedBy                LastEditedBy?
  aiGenerated                 Boolean             @default(false)
  userConfirmed               Boolean             @default(false)
  teamId                      String
  dayId                       String?
  displayOrder                Int?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  assignment                  Assignment?
  day                         Day?                @relation(fields: [dayId], references: [id])
  team                        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, displayOrder])
}

model Assignment {
  id        String             @id @default(cuid())
  response  AssignmentResponse @default(PENDING)
  createdAt DateTime           @default(now())
  itemId    String             @unique
  personId  String
  item      Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person    Person             @relation(fields: [personId], references: [id])
}

model InviteEvent {
  id        String          @id @default(cuid())
  eventId   String
  personId  String?
  type      InviteEventType
  metadata  Json?
  createdAt DateTime        @default(now())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person?         @relation(fields: [personId], references: [id])

  @@index([eventId])
  @@index([personId])
  @@index([type])
  @@index([createdAt])
}

model SmsOptOut {
  id          String   @id @default(cuid())
  phoneNumber String
  hostId      String
  optedOutAt  DateTime @default(now())
  rawMessage  String?
  host        Person   @relation("HostOptOuts", fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([phoneNumber, hostId])
  @@index([phoneNumber])
  @@index([hostId])
}

model AccessToken {
  id        String     @id @default(cuid())
  token     String     @unique
  scope     TokenScope
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  eventId   String
  personId  String
  teamId    String?
  openedAt  DateTime?
  claimedAt DateTime?
  claimedBy String?
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  team      Team?      @relation(fields: [teamId], references: [id])

  @@unique([eventId, personId, scope, teamId])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  billingStatus BillingStatus @default(FREE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  eventRoles    EventRole[]
  people        Person[]
  sessions      Session[]
  subscription  Subscription?

  @@index([email])
}

model Subscription {
  id                   String        @id @default(cuid())
  userId               String        @unique
  stripeCustomerId     String        @unique
  stripeSubscriptionId String?       @unique
  stripePriceId        String?
  status               BillingStatus @default(FREE)
  statusChangedAt      DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@index([expiresAt])
}

model EventRole {
  id        String        @id @default(cuid())
  userId    String
  eventId   String
  role      EventRoleType
  createdAt DateTime      @default(now())
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

/// THE LEDGER (GTC-168 / A2).
///
/// Extended in place rather than replaced: ~15 call sites all funnel through
/// logAudit(), so extension preserves existing history with no data migration.
///
/// VERSIONS ARE LEDGER ENTRIES (Hinge spec §2, "reasons explain the steps; versions
/// ARE the steps"). `sequence` IS the version number. Version N of the plan is the
/// state after entry N. This is what makes storage tractable: a scoped entry costs
/// 455–1601 B against 156.6 KB for a full PlanRevision snapshot of the demo event —
/// a 285x ratio, measured 2026-08-03. See send-lock-reconciliation-plan.md §6.
///
/// InviteEvent remains a SEPARATE log for messaging/channel telemetry (LINK_OPENED,
/// NUDGE_SENT_AUTO, SMS_BLOCKED_OPT_OUT, guest responses). Do not merge them: Hinge §2
/// — "the ledger stays meaningful because it is never asked to hold noise."
model AuditEntry {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  eventId   String

  /// The version number, monotonic per event. NULL = a pre-ledger audit row: it
  /// predates versioning and was never a version. Postgres permits multiple NULLs
  /// under the composite unique, so no history is fabricated to satisfy the schema.
  sequence Int?

  /// One request = one changeSet = one human-visible step. A single request that
  /// changes three fields emits three rows sharing one changeSetId ("I renamed and
  /// re-quantified the pavlova" is one step to a person). Granularity stays
  /// per-individual-change; the grouping is a display key, not batching.
  /// NULL = pre-ledger row.
  changeSetId String?

  /// NULLABLE by design: the calendar, the cron sweep, and the release-notification
  /// path have no Person to point at. The system is a first-class actor in the
  /// history (Hinge §7: "the system does what the system does").
  ///
  /// The FK is ON DELETE SET NULL, so deleting a Person no longer blocks — the
  /// history survives them. That is right for a ledger and wrong for a memory:
  /// without a name the entry degrades to "someone reassigned the beef".
  actorId   String?
  actorKind ActorKind @default(HOST)

  /// NAME AT TIME OF ACTION — denormalised on purpose, populated at write time
  /// (GTC-196 / A3b), never re-read from Person. Two reasons it must not be a join:
  /// the actor may be deleted (SET NULL above), and a later rename would silently
  /// rewrite history. The ledger is Kate's memory of what happened, and what
  /// happened is that *Pete* was the one who couldn't do it. NULL for SYSTEM
  /// actions and for pre-ledger rows.
  actorName String?

  actionType String
  targetType String
  targetId   String

  /// NULL for whole-entity actions (create/delete). Otherwise the changed field.
  field String?

  /// Scoped to the changed entity — NEVER the whole plan. `before` is what makes
  /// history reachable backwards by inversion; the CONFIRMING PlanSnapshot makes it
  /// reachable forwards. Neither requires a snapshot per change.
  before Json?
  after  Json?

  /// NULLABLE BY DESIGN — plan §13.1, endorsed by Nigel 2026-08-03. The why is
  /// required only for changes that touch someone (T1–T5), but "required" means the
  /// flow always asks, NOT that the server rejects. Moment 4 §7 forbids the product
  /// demanding justification; Hinge §2 says the reason "is not compliance — it's her
  /// own memory". A 400 would make it compliance. NO ROUTE MAY 4xx FOR A MISSING
  /// REASON. reasonRequired records that the rule fired, so a null reason is never
  /// ambiguous between "not owed" and "owed and not given".
  reason         String?
  reasonRequired Boolean @default(false)

  /// Retained for the ~15 pre-ledger call sites and their existing rows.
  details String?

  actor Person? @relation(fields: [actorId], references: [id])
  event Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sequence])
  @@index([eventId, timestamp])
  @@index([changeSetId])
}

/// Who made a change. Needed because AuditEntry.actorId is nullable — SYSTEM actions
/// (the calendar transition, the cron sweep, a release notification) have no Person.
/// The why-scope rule is actor-agnostic: a coordinator owes the same why a host does
/// (ruled by Nigel 2026-08-03 — "no walls anywhere, ledger is actor-agnostic").
enum ActorKind {
  HOST
  COHOST
  COORDINATOR
  GUEST
  SYSTEM
}

model Conflict {
  id                      String            @id @default(cuid())
  eventId                 String
  fingerprint             String
  type                    ConflictType
  severity                ConflictSeverity
  claimType               ClaimType
  resolutionClass         ResolutionClass
  title                   String
  description             String
  affectedItems           Json?
  affectedDays            Json?
  affectedParties         Json?
  equipment               String?
  timeSlot                String?
  capacityAvailable       Float?
  capacityRequired        Float?
  dietaryType             String?
  guestCount              Int?
  category                String?
  currentCoverage         Int?
  minimumNeeded           Int?
  inputsReferenced        Json?
  status                  ConflictStatus    @default(OPEN)
  viewed                  Boolean           @default(false)
  viewDuration            Int               @default(0)
  whyThisViewed           Boolean           @default(false)
  dismissedWithoutReading Boolean           @default(false)
  resolvedBy              String?
  resolvedAt              DateTime?
  dismissedAt             DateTime?
  delegatedTo             DelegatedTo?
  delegatedAt             DateTime?
  canDelegate             Boolean           @default(false)
  delegateToRoles         Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  acknowledgements        Acknowledgement[]
  event                   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([fingerprint])
}

model Acknowledgement {
  id                          String                 @id @default(cuid())
  conflictId                  String
  eventId                     String
  acknowledgedAt              DateTime
  acknowledgedBy              String
  impactStatement             String
  impactUnderstood            Boolean
  mitigationPlanType          MitigationPlanType
  affectedParties             Json?
  alternativesConsidered      AlternativesConsidered @default(NONE)
  visibilityCohosts           Boolean                @default(true)
  visibilityCoordinators      String                 @default("NONE")
  visibilityParticipants      Boolean                @default(false)
  supersedesAcknowledgementId String?
  status                      AcknowledgementStatus  @default(ACTIVE)
  createdAt                   DateTime               @default(now())
  conflict                    Conflict               @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  event                       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([conflictId])
}

model PlanRevision {
  id               String   @id @default(cuid())
  eventId          String
  revisionNumber   Int
  teams            Json
  items            Json
  days             Json
  conflicts        Json
  acknowledgements Json
  createdAt        DateTime
  createdBy        String
  reason           String?
  currentForEvents Event[]  @relation("EventCurrentRevision")
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model PlanSnapshot {
  id               String        @id @default(cuid())
  eventId          String
  phase            SnapshotPhase
  teams            Json
  items            Json
  days             Json
  criticalFlags    Json
  acknowledgements Json
  createdAt        DateTime      @default(now())
  confirmingEvents Event[]       @relation("EventConfirmingSnapshot")
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model StructureTemplate {
  id               String         @id @default(cuid())
  hostId           String
  templateSource   TemplateSource
  name             String
  occasionType     String
  teams            Json
  items            Json
  days             Json
  version          String?
  changelogSummary String?
  publishedAt      DateTime?
  createdFrom      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([hostId])
  @@index([templateSource])
}

model QuantitiesProfile {
  id             String   @id @default(cuid())
  hostId         String
  occasionType   String
  derivedFrom    Json
  ratios         Json
  itemQuantities Json
  overrides      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hostId, occasionType])
}

model HostMemory {
  id                           String                @id @default(cuid())
  hostId                       String                @unique
  learningEnabled              Boolean               @default(false)
  aggregateContributionConsent Boolean               @default(false)
  useHistoryByDefault          Boolean               @default(false)
  updatedAt                    DateTime              @updatedAt
  dismissedSuggestions         DismissedSuggestion[]
  defaults                     HostDefault[]
  host                         Person                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  patterns                     HostPattern[]
}

model HostPattern {
  id           String            @id @default(cuid())
  hostMemoryId String
  occasionType String
  patternType  PatternType
  patternData  Json
  derivedFrom  Json
  confidence   PatternConfidence
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  hostMemory   HostMemory        @relation(fields: [hostMemoryId], references: [id], onDelete: Cascade)

  @@index([hostMemoryId])
}

model HostDefault {
  id           String     @id @default(cuid())
  hostMemoryId String
  field        String
  value        Json
  setAt        DateTime
  hostMemory   HostMemory @relation(fields: [hostMemoryId], references: [id], onDelete: Cascade)

  @@index([hostMemoryId])
}

model DismissedSuggestion {
  id             String     @id @default(cuid())
  hostMemoryId   String
  suggestionType String
  dismissedAt    DateTime
  count          Int
  hostMemory     HostMemory @relation(fields: [hostMemoryId], references: [id], onDelete: Cascade)

  @@index([hostMemoryId])
}

model DeletionReceipt {
  id                          String        @id @default(cuid())
  hostId                      String
  deletedAt                   DateTime
  scope                       DeletionScope
  targetIds                   Json?
  derivedArtifactsRemoved     Boolean
  aggregateContributionPurged Boolean
}

enum PersonRole {
  HOST
  COORDINATOR
  PARTICIPANT
}

enum HouseholdRole {
  PRIMARY_CONTACT
  PARTNER
  GUEST
  CHILD
}

enum ReachabilityTier {
  DIRECT
  PROXY
  SHARED
  UNTRACKABLE
}

enum ContactMethod {
  EMAIL
  SMS
  NONE
}

enum EventRoleType {
  HOST
  COHOST
  COORDINATOR
}

enum ItemStatus {
