  @@index([email])
  @@index([expiresAt])
}

model EventRole {
  id           String        @id @default(cuid())
  userId       String
  eventId      String
  role         EventRoleType
  createdAt    DateTime      @default(now())
  /// GTC-192 (J1, phase 5): RULING 9's REPLAY MEMORY — when THIS viewer was last shown the
  /// glance's news. The arrival replay opens on the state as of her last visit and plays the
  /// changes since; this is the only thing that remembers where "since" starts.
  ///
  /// PER VIEWER, BY RULING 20 (2026-09-08) — not by inference from @@unique([userId, eventId]).
  /// A COHOST has her own row and her own glanceSeenAt, and a reversal the host has watched
  /// settle stays sticky red for the co-host until she watches it too: "the red does not mean
  /// someone must act on this — it means this person changed, and that news is owed to each of
  /// them once." Ruling 6's "settles once played" is therefore PER PERSON, not per event. The
  /// unique key makes this free to build; the ruling is what makes it right.
  ///
  /// THIS IS THE HOST'S OWN TIMESTAMP, NOT GUEST DATA. Ruling 1 fences the replay to state
  /// changes — "no opens, no views, no hesitations, ever" — and that fence is about GUESTS.
  /// Ruling 9 permits exactly this one field and nothing beside it: "Nothing about guests is
  /// tracked — only her own glance." DO NOT read this as a precedent for a viewed/opened/seen
  /// field on PersonEvent, Person or Assignment. It is also never rendered, to her or to anyone.
  ///
  /// NULL MEANS NO BASELINE, NOT A BASELINE OF LONG AGO. Phase 6 must branch on null
  /// explicitly: null -> play NOTHING and stamp now. Treating null as epoch replays the entire
  /// history of the event on a host's first ever visit — the maximum fake-fireworks case.
  /// "Nothing changed -> nothing plays" is the SEPARATE rule that an EMPTY DIFF produces; it is
  /// not what null produces.
  ///
  /// STAMPED WHEN THE REPLAY PLAYED, NOT WHEN THE PAGE RENDERED (Ruling 6: "'Seen' means the
  /// replay played"). Stamping on render settles a sticky reversal she never watched, and burns
  /// on a refresh or a next/link prefetch.
  ///
  /// SCOPED TO THE GLANCE BY ITS NAME, DELIBERATELY. A generic lastViewedAt here would be
  /// written by the next screen that wants one, and the replay would stop replaying with nothing
  /// failing. The design reference's sketched "lastViewedAt" is not the name (Ruling 20's pass).
  ///
  /// NOTHING READS OR WRITES THIS AS OF PHASE 5. Phase 6 is the reader and the writer.
  glanceSeenAt DateTime?
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

/// THE LEDGER (GTC-168 / A2).
///
/// Extended in place rather than replaced: ~15 call sites all funnel through
/// logAudit(), so extension preserves existing history with no data migration.
///
/// VERSIONS ARE LEDGER ENTRIES (Hinge spec §2, "reasons explain the steps; versions
/// ARE the steps"). `sequence` IS the version number. Version N of the plan is the
/// state after entry N. This is what makes storage tractable: a scoped entry costs
/// 455–1601 B against 156.6 KB for a full PlanRevision snapshot of the demo event —
/// a 285x ratio, measured 2026-08-03. See send-lock-reconciliation-plan.md §6.
///
/// InviteEvent remains a SEPARATE log for messaging/channel telemetry (LINK_OPENED,
/// NUDGE_SENT_AUTO, SMS_BLOCKED_OPT_OUT, guest responses). Do not merge them: Hinge §2
/// — "the ledger stays meaningful because it is never asked to hold noise."
model AuditEntry {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  eventId   String

  /// The version number, monotonic per event. NULL = a pre-ledger audit row: it
  /// predates versioning and was never a version. Postgres permits multiple NULLs
  /// under the composite unique, so no history is fabricated to satisfy the schema.
  sequence Int?

  /// One request = one changeSet = one human-visible step. A single request that
  /// changes three fields emits three rows sharing one changeSetId ("I renamed and
  /// re-quantified the pavlova" is one step to a person). Granularity stays
  /// per-individual-change; the grouping is a display key, not batching.
  /// NULL = pre-ledger row.
  changeSetId String?

  /// NULLABLE by design: the calendar, the cron sweep, and the release-notification
  /// path have no Person to point at. The system is a first-class actor in the
  /// history (Hinge §7: "the system does what the system does").
  ///
  /// The FK is ON DELETE SET NULL, so deleting a Person no longer blocks — the
  /// history survives them. That is right for a ledger and wrong for a memory:
  /// without a name the entry degrades to "someone reassigned the beef".
  actorId   String?
  actorKind ActorKind @default(HOST)

  /// NAME AT TIME OF ACTION — denormalised on purpose, populated at write time
  /// (GTC-196 / A3b), never re-read from Person. Two reasons it must not be a join:
  /// the actor may be deleted (SET NULL above), and a later rename would silently
  /// rewrite history. The ledger is Kate's memory of what happened, and what
  /// happened is that *Pete* was the one who couldn't do it. NULL for SYSTEM
  /// actions and for pre-ledger rows.
  actorName String?

  actionType String
  targetType String
  targetId   String

  /// NULL for whole-entity actions (create/delete). Otherwise the changed field.
  field String?

  /// Scoped to the changed entity — NEVER the whole plan. `before` is what makes
  /// history reachable backwards by inversion; the CONFIRMING PlanSnapshot makes it
  /// reachable forwards. Neither requires a snapshot per change.
  before Json?
  after  Json?

  /// NULLABLE BY DESIGN — plan §13.1, endorsed by Nigel 2026-08-03. The why is
  /// required only for changes that touch someone (T1–T5), but "required" means the
  /// flow always asks, NOT that the server rejects. Moment 4 §7 forbids the product
  /// demanding justification; Hinge §2 says the reason "is not compliance — it's her
  /// own memory". A 400 would make it compliance. NO ROUTE MAY 4xx FOR A MISSING
  /// REASON. reasonRequired records that the rule fired, so a null reason is never
  /// ambiguous between "not owed" and "owed and not given".
  reason         String?
  reasonRequired Boolean @default(false)

  /// Retained for the ~15 pre-ledger call sites and their existing rows.
  details String?

  actor Person? @relation(fields: [actorId], references: [id])
  event Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sequence])
  @@index([eventId, timestamp])
  @@index([changeSetId])
}

/// Who made a change. Needed because AuditEntry.actorId is nullable — SYSTEM actions
/// (the calendar transition, the cron sweep, a release notification) have no Person.
/// The why-scope rule is actor-agnostic: a coordinator owes the same why a host does
/// (ruled by Nigel 2026-08-03 — "no walls anywhere, ledger is actor-agnostic").
enum ActorKind {
  HOST
  COHOST
  COORDINATOR
  GUEST
  SYSTEM
}

