generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                         String                   @id @default(cuid())
  name                       String
  startDate                  DateTime
  endDate                    DateTime
  status                     EventStatus              @default(DRAFT)
  archived                   Boolean                  @default(false)
  guestCount                 Int?
  isLegacy                   Boolean                  @default(false)
  isDemo                     Boolean                  @default(false)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  occasionType               OccasionType?
  occasionDescription        String?
  hostId                     String
  coHostId                   String?
  guestCountConfidence       GuestCountConfidence     @default(MEDIUM)
  guestCountMin              Int?
  guestCountMax              Int?
  // GTC-184: superseded by EventSetup.dietaryData (the GTC-150 three-state model,
  // read via readDietaryData()) for conflict detection as of check.ts's
  // detectDietaryGaps. Deprecated in place, not removed — these fields remain live
  // for V1 generation and regenerate (9+ consumers per the GTC-228 reconciliation
  // trace), so do not delete or stop writing them without a dedicated ticket.
  dietaryStatus              DietaryStatus            @default(UNSPECIFIED)
  dietaryVegetarian          Int                      @default(0)
  dietaryVegan               Int                      @default(0)
  dietaryGlutenFree          Int                      @default(0)
  dietaryDairyFree           Int                      @default(0)
  dietaryAllergies           String?
  venueName                  String?
  venueType                  VenueType?
  venueKitchenAccess         KitchenAccess?
  venueOvenCount             Int                      @default(0)
  venueStoretopBurners       Int?
  venueBbqAvailable          Boolean?
  venueTimingStart           String?
  venueTimingEnd             String?
  venueNotes                 String?
  generationPath             GenerationPath?
  clonedFromId               String?
  cloneAdaptations           Json?
  checkPlanInvocations       Int                      @default(0)
  firstCheckPlanAt           DateTime?
  lastCheckPlanAt            DateTime?
  checkPlanBeforeGate        Boolean                  @default(false)
  transitionAttempts         Json?
  transitionedToConfirmingAt DateTime?
  planSnapshotIdAtConfirming String?
  structureMode              StructureMode            @default(EDITABLE)
  blindAccept                Boolean                  @default(false)
  madeAnyEditBeforeCheckPlan Boolean                  @default(false)
  manualAdditionsCount       Int                      @default(0)
  hostReadinessConfidence    HostReadinessConfidence?
  currentRevisionId          String?
  // GTC-168 (A2): THE SEND. Renamed from inviteSendConfirmedAt — this field already
  // was the send (it anchors the nudge machinery and fires before freezing), so the
  // rename is Prisma-level only via @map: the column keeps its name and its data, and
  // no SQL runs. The physical column rename is deferred to GTC-199 (A4), which already
  // requires a backup. See send-lock-reconciliation-plan.md §0.1, §2.
  sentAt                     DateTime?                @map("inviteSendConfirmedAt")
  /// GTC-175 (D2): the per-EVENT decide-by offset — layer 2 of the three-layer
  /// resolution in src/lib/decide-by.ts (item override → this → system default).
  /// Hours BEFORE neededBy(); NULL means "not set", not "zero".
  ///
  /// PRODUCT INTENT, for the J-epic ticket that builds the host control (D2 builds no
  /// UI): the system default is 5 days (DEFAULT_DECIDE_BY_OFFSET_HOURS = 120) and the
  /// host-facing "decide faster" toggle is THIS field set to 48 — two days. That is not
  /// a second field or a second code path; it is this layer exercised with a 2-day
  /// value, and the resolution already handles it.
  ///
  /// Moment 4 §10.2 rules a third axis, per-PERSON, which E3 (GTC-180) owns.
  /// resolveDecideByOffsetHours takes a params object so that layer slots in without
  /// touching a call site.
  decideByOffsetHours        Int?
  /// GTC-179 (E2, phase 2): the per-EVENT nudge pace (Moment 4 §10.3). NULL means NOT
  /// SET — no opinion — and resolves to the system default [4, 7], exactly the
  /// convention `decideByOffsetHours` directly above records. It is NOT "zero", and it
  /// is NOT a stored STANDARD: an unset pace and an explicit STANDARD reach the same
  /// days by different routes, and only the unset one yields to a future change in the
  /// default.
  ///
  /// A TYPED COLUMN, NOT EventSetup JSONB (founder ruling on decision 10, 2026-08-27).
  /// The nudge scheduler reads this on every 15-minute cron tick; `decideByOffsetHours`
  /// is the existing precedent for a scheduler-read tuning value and it is a typed
  /// column; EventSetup's JSON tenants are Moment-2 form state, an unrelated concern;
  /// and a typed enum gets database-level validity checking that JSONB does not.
  ///
  /// READ IT THROUGH `resolveNudgeOffsetDays` IN src/lib/nudge-cadence.ts, never
  /// directly. It composes with PersonEvent.nudgeMark by QUIETER-WINS (Ruling 4), which
  /// is not an override ladder — a GENTLE person on an OFF event gets NO nudges, not
  /// one. Reading this column alone would get that backwards.
  ///
  /// NO BACKFILL, and none is needed: nullable, and null is existing behaviour.
  ///
  /// GTC-188 (I1) builds the pre-flight surface Kate sets this on. Until it lands there
  /// is no host-facing way to set it — deliberate, and stated rather than implied.
  nudgePace                  NudgePace?
  /// GTC-189 ruling AH (decision 25) — THE EVENT-LEVEL DEFAULT for the chase's channel:
  /// the founder's own sentence, "chase by email when there's no mobile", ON.
  ///
  /// A SIBLING OF `nudgePace` DIRECTLY ABOVE, and deliberately its shape: nullable, per
  /// event, host-set, NULL MEANS NOT SET — no opinion. It is NOT a stored BY_EMAIL. An
  /// unset default and an explicit BY_EMAIL reach the same behaviour by different routes,
  /// and only the unset one yields to a future change in the system default. That is the
  /// convention `nudgePace` records above and `decideByOffsetHours` before it.
  ///
  /// NO BACKFILL — and THE REASON DIFFERS FROM `nudgePace`'s, recorded rather than
  /// inherited. For `nudgePace`, "null is existing behaviour". Here it is not: the chase
  /// has no email leg in code at all today. No backfill is needed because nothing reads
  /// this column until slice 8, and every existing row then wants exactly the ruled
  /// default.
  ///
  /// A TYPED COLUMN, NOT EventSetup JSONB — the same question the founder already ruled
  /// for `nudgePace` (GTC-179 decision 10, and Ruling 5), with the same answers: the
  /// chase reads this on every 15-minute cron tick, `decideByOffsetHours` is the
  /// precedent for a scheduler-read tuning value and is a typed column, and an enum gets
  /// database-level validity checking that JSONB does not. Measured read-only on
  /// 2026-09-18: gather_dev holds 29 Events and 7 EventSetup rows, so 22 of 29 would need
  /// a row created purely to hold a default.
  ///
  /// READ IT THROUGH `resolveChaseWhenNoMobile`, NEVER DIRECTLY. It composes with
  /// `PersonEvent.chaseException` by THE NAMED EXCEPTION WINS (ruling AL) — see that
  /// column's docstring for the founder's reason, and the `ChaseWhenNoMobile` enum's for
  /// the expression.
  ///
  /// NOTHING READS OR WRITES THIS AS OF SLICE 4. The control is GTC-311's, the reader is
  /// slice 8's.
  chaseWhenNoMobileDefault   ChaseWhenNoMobile?
  /// GTC-259: the host's movement 1 for the ask - Kate's own words, the first of the three
  /// movements Hinge §5 makes seam-visible (GTC-187 decision 2, "stored, not ephemeral").
  ///
  /// THREE STATES, NOT TWO (founder ruling, 2026-08-29). NULL and empty string are DIFFERENT
  /// FACTS and the difference is load-bearing. `composeAsk` reads this as
  /// `storedAuthorLine ?? draftAuthorLine(event)` in src/lib/messages/ask-register.ts, and
  /// `??` falls through on null but NOT on `''` - which is exactly what makes all three
  /// reachable through one expression:
  ///
  ///   NULL   never authored          -> falls through to the generated draft
  ///   ''     DELIBERATELY NO LINE    -> `authorLineFor` returns the bare greeting, "Hi Rob,",
  ///                                     and does NOT fall through to the draft
  ///   value  the host's words        -> "Hi Rob - <value>"
  ///
  /// NULL keeps the not-set convention `decideByOffsetHours` and `nudgePace` directly above
  /// use. `''` is a stored value like any other, and means she said her piece by declining to.
  ///
  /// ⚠ SUPERSEDED, KEPT FOR THE REASON: an earlier rule the same day required the write site
  /// to NORMALISE EMPTY TO NULL, on the grounds that a stored `''` "suppresses the draft".
  /// It does suppress the draft - that part was measured and is true - but suppressing the
  /// draft turned out to be the FEATURE, not the bug. The founder ruling that replaced it:
  /// `authorLineFor`'s own comment already treats the blank case as deliberate ("hers to cut
  /// to nothing"), and Hinge §5 makes the HANDOVER the load-bearing beat, not movement 1's
  /// length. A host sending to sixty people, or re-sending after she has already said her
  /// piece, must be able to decline to speak without Gather's words standing in for hers.
  /// The write site therefore PRESERVES `''` and must not collapse it to NULL.
  ///
  /// Whitespace-only IS normalised - to `''`, not to NULL. `authorLineFor` trims before
  /// deciding, so `'   '` composes identically to `''`; storing it verbatim would be a fourth
  /// spelling of the third state. Values are stored trimmed, so the column holds exactly
  /// NULL, `''`, or a trimmed non-empty string and nothing else.
  ///
  /// Enforced in the PATCH at src/app/api/events/[id]/pre-flight/message/route.ts (GTC-260).
  ///
  /// ONE VALUE, LAST WRITE WINS (GTC-187, 2026-08-29). A mini-send edit overwrites; no
  /// per-send version lives here. What each recipient actually received is GTC-189's to
  /// decide and does not belong in this column.
  ///
  /// NOT LENGTH-CAPPED, on purpose - GTC-187 decision 6: "no enforced cap ... do not
  /// truncate, do not block". Prisma maps `String` to Postgres `TEXT`.
  ///
  /// NOT EventSetup JSONB. EventSetup is Moment-2 form state and does not exist for most
  /// events - 7 of 9 in the development database, including Henderson Family Christmas 2026,
  /// the CONFIRMING event that reaches the pre-flight. GTC-179 Ruling 5 made the same call
  /// on the same question for `nudgePace`. Full check in GTC-259.
  ///
  /// WIRED BY GTC-260: read and written by the pre-flight message route, set on the
  /// pre-flight screen. GTC-259 added the column and deliberately wired nothing.
  askAuthorLine              String?
  sharedLinkToken            String?                  @unique
  sharedLinkEnabled          Boolean                  @default(false)
  // Retained, unwritten after GTC-169 (A3a). Historical evidence of the old freeze
  // ceremony. Dropped by GTC-199 (A4).
  frozenAt                   DateTime?
  complianceAtFreeze         Float?
  freezeReason               String?
  wrappedAt                  DateTime?
  stripePaymentIntentId      String?                  @unique
  paidAt                     DateTime?
  amountPaid                 Int?
  tokens                     AccessToken[]
  acknowledgements           Acknowledgement[]
  auditLog                   AuditEntry[]
  conflicts                  Conflict[]
  days                       Day[]
  clonedFrom                 Event?                   @relation("EventClone", fields: [clonedFromId], references: [id])
  clonedEvents               Event[]                  @relation("EventClone")
  coHost                     Person?                  @relation("EventCoHost", fields: [coHostId], references: [id])
  currentRevision            PlanRevision?            @relation("EventCurrentRevision", fields: [currentRevisionId], references: [id])
  host                       Person                   @relation("EventHost", fields: [hostId], references: [id])
  planSnapshotAtConfirming   PlanSnapshot?            @relation("EventConfirmingSnapshot", fields: [planSnapshotIdAtConfirming], references: [id])
  eventRoles                 EventRole[]
  households                 Household[]
  inviteEvents               InviteEvent[]
  deliveryReports            SmsDeliveryReport[]
  outboundMessages           OutboundMessage[]
  people                     PersonEvent[]
  revisions                  PlanRevision[]
  snapshots                  PlanSnapshot[]
  teams                      Team[]
  aiCallsUsed                Int                      @default(0)
  wrapUpLinks                WrapUpLink[]
  setup                      EventSetup?
}

model Day {
  id      String   @id @default(cuid())
  name    String
  date    DateTime
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   Item[]
}

model Team {
  id               String           @id @default(cuid())
  name             String
  scope            String?
  domain           Domain?
  domainConfidence DomainConfidence @default(MEDIUM)
  displayOrder     Int              @default(0)
  source           ItemSource       @default(MANUAL)
  isProtected      Boolean          @default(false)
  eventId          String
  coordinatorId    String?
  tokens           AccessToken[]
  items            Item[]
  members          PersonEvent[]
  coordinator      Person?          @relation("TeamCoordinator", fields: [coordinatorId], references: [id])
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Person {
  id               String              @id @default(cuid())
  name             String
  email            String?             @unique
  phone            String?
  userId           String?
  phoneNumber      String?
  smsOptedOut      Boolean             @default(false)
  smsOptedOutAt    DateTime?
  inviteAnchorAt   DateTime?
  /// GTC-178 (E1, phase 3): SUPERSEDED BY PersonEvent.firstNudgeSentAt /
  /// secondNudgeSentAt. These are per-person for a per-EVENT fact — the same
  /// global-anchor leak as inviteAnchorAt directly above: one person in two events has
  /// one pair of flags, so a nudge sent for event A silences event B. Phase 2 fixed the
  /// read side of that leak (the clock); the successor columns fix the write side.
  ///
  /// RETAINED BUT UNWRITTEN as of phase 4 (the cutover). Nothing reads or writes these:
  /// nudge-sender.ts stamps PersonEvent.firstNudgeSentAt/secondNudgeSentAt,
  /// nudge-eligibility.ts dedups on the same two columns, and all four dashboard
  /// consumers (invite-status, invite-detail, InviteStatusSection,
  /// PersonInviteDetailModal) now source them from the membership row. Kept for one
  /// ticket so the change reverts cleanly and any stray value stays auditable — exactly
  /// the treatment GTC-168 (A2) gave Person.inviteAnchorAt and GTC-174 (D1) gave
  /// rsvpStatus. A later ticket drops them.
  ///
  /// DO NOT READ THESE. Both were null on every row at the cutover (verified: 0 non-null
  /// of every Person, phase 3), so a value appearing here now can only come from code
  /// that should not exist. Read the PersonEvent columns — always.
  nudge24hSentAt   DateTime?
  nudge48hSentAt   DateTime?
  tokens           AccessToken[]
  assignments      Assignment[]
  auditActions     AuditEntry[]
  cohostedEvents   Event[]             @relation("EventCoHost")
  hostedEvents     Event[]             @relation("EventHost")
  hostMemory       HostMemory?
  inviteEvents     InviteEvent[]
  deliveryReports  SmsDeliveryReport[]
  user             User?               @relation(fields: [userId], references: [id])
  eventMemberships PersonEvent[]
  receivedOptOuts  SmsOptOut[]         @relation("HostOptOuts")
  coordinatedTeams Team[]              @relation("TeamCoordinator")
  wrapUpLinks      WrapUpLink[]

  @@index([userId])
  @@index([email])
}

model PersonEvent {
  id                   String             @id @default(cuid())
  personId             String
  eventId              String
  teamId               String?
  role                 PersonRole         @default(PARTICIPANT)
  reachabilityTier     ReachabilityTier   @default(UNTRACKABLE)
  contactMethod        ContactMethod      @default(NONE)
  claimedViaSharedLink Boolean            @default(false)
  proxyPersonEventId   String?
  /// GTC-174 (D1): RETAINED BUT UNWRITTEN. Hinge §3 (ruled gap #10) supersedes
  /// event-level RSVP as a guest-facing question — the tap is the item ask and
  /// attendance is INFERRED from it. No reachable path writes these three after D1, and
  /// every reader has moved to deriveAttendance() in src/lib/attendance.ts. (One dead
  /// write to rsvpFollowupSentAt survives in nudge-sender.ts behind a caller D1
  /// neutralised — GTC-178 deletes that path whole.) They are kept for one ticket so the
  /// backfill stays auditable and the change reverts cleanly — exactly the treatment
  /// GTC-168 (A2) gave Person.inviteAnchorAt. GTC-219 drops all three plus the
  /// RsvpStatus enum.
  ///
  /// DO NOT READ THESE. A stored answer to a derived question is the Item.status
  /// mistake again (architecture-contract §6): it drifts, and what it makes lie is the
  /// host's headcount. Read deriveAttendance() instead — always.
  rsvpStatus           RsvpStatus         @default(PENDING)
  rsvpRespondedAt      DateTime?
  rsvpFollowupSentAt   DateTime?
  /// GTC-174 (D1): the ONLY stored attendance fact — what the guest answered when
  /// attendance was genuinely ASKED. Hinge §3 gives exactly two such moments: the
  /// conditional no-follow-up ("no worries — still coming?") and the itemless
  /// degenerate case. Everywhere else attendance is inferred from the item tap and
  /// must be read through deriveAttendance(), never from a column.
  ///
  /// NULL means NEVER ASKED — it is not a third answer. There is deliberately no
  /// MAYBE here: Hinge §8 rules a maybe purely an ITEM-maybe, carried on
  /// Assignment.response, with attendance unknown until D2's decide-by resolves it.
  attendanceAnswer     AttendanceAnswer?
  attendanceAnsweredAt DateTime?
  /// GTC-168 (A2): THIS person's send clock — the mini-send anchor (Hinge §2, gap #5).
  /// Set to Event.sentAt at the press; set to now() for anyone added afterwards, so
  /// their nudge cadence and red-by-time run from THEIR send date, truncated by the
  /// event date. isMiniSend = PersonEvent.sentAt > Event.sentAt — no extra field.
  ///
  /// Replaces Person.inviteAnchorAt, which holds the same value on the WRONG MODEL:
  /// Person is global, so a person in two events shares one anchor and the second
  /// event's clocks are wrong from the start (the guard at people/route.ts:133 only
  /// sets it when null). Person.inviteAnchorAt is retained-but-unwritten until
  /// GTC-199 (A4). Person.nudge24hSentAt/nudge48hSentAt carried the identical leak and
  /// moved under GTC-178 (E1) — see firstNudgeSentAt/secondNudgeSentAt below.
  sentAt               DateTime?
  /// GTC-178 (E1, phase 3): THE SENT-SIDE DEDUP STATE, per event. Stamped on a
  /// successful auto-nudge send; read as "has this leg already fired for this person on
  /// THIS event". Relocates the shape of Person.nudge24hSentAt/nudge48hSentAt onto the
  /// row that owns the clock they are measured against (sentAt, directly above).
  ///
  /// ORDINAL, NOT TIMING-BASED (Ruling 7, 2026-08-27). Deliberately NOT nudgeDay4SentAt:
  /// GTC-179 (E2) makes the cadence adjustable per event and per person
  /// (standard/relaxed/off), so a column named after a day count starts lying the moment
  /// E2 lands. "First" and "second" stay true at every pace. Same reasoning as
  /// Assignment.decideByFollowupSentAt, which names the EVENT rather than its timing.
  ///
  /// NO BACKFILL (Ruling 6, 2026-08-27) — CONDITIONAL, and the condition is recorded
  /// because it can lapse. Verified immediately before this migration: zero
  /// InviteEvent NUDGE_SENT_AUTO rows, zero non-null Person.nudge24hSentAt, zero
  /// non-null Person.nudge48hSentAt. Nobody has ever been messaged, so there is no send
  /// history to preserve. Had there been any, starting these columns null would make
  /// every person past their first window eligible again on the next 15-minute cron
  /// tick — a re-nudge burst with the same TCPA/spam shape as GTC-252.
  ///
  /// LIVE AS OF PHASE 4. nudge-sender.ts stamps these on a successful send (and only on
  /// success — a failed send leaves no stamp and the next tick retries), and
  /// nudge-eligibility.ts dedups on them. Person.nudge24hSentAt/nudge48hSentAt are now
  /// retained-but-unwritten. The retime to day-4/day-7 is phase 5, which changes WHEN
  /// these are stamped and never WHERE.
  firstNudgeSentAt     DateTime?
  secondNudgeSentAt    DateTime?
  /// GTC-179 (E2, phase 2): the per-PERSON go-gentle / don't-chase mark (Moment 4
  /// §10.3). NULL means NO MARK — no opinion — and yields to the event's pace; it is
  /// not a stored "normal".
  ///
  /// ON PersonEvent, NOT Person, and that is the whole point. The mark is a per-EVENT
  /// hosting judgement: Kate may go gentle on her mother for the wake and not for the
  /// birthday. Putting it on Person would reproduce exactly the global-for-a-per-event
  /// leak that Person.inviteAnchorAt and Person.nudge24hSentAt/nudge48hSentAt above are
  /// both retained-but-unwritten monuments to (GTC-178 Rulings 2 and 4).
  ///
  /// PersonEvent CARRIES NO JSON COLUMN, so unlike the event-side pace this had no
  /// no-migration alternative to weigh — the storage question here was only ever WHICH
  /// table, and the answer is the one that owns the send clock these offsets count from
  /// (`sentAt`, above).
  ///
  /// READ IT THROUGH `resolveNudgeOffsetDays` IN src/lib/nudge-cadence.ts, never
  /// directly — quieter-wins composition with Event.nudgePace (Ruling 4).
  ///
  /// DONT_CHASE MUST ALSO SUPPRESS THE PROXY PATH (Ruling 3). §10.3's archetype is "the
  /// mother", and the mother is the person most likely to be her household's picked
  /// channel (Household.contactPersonEventId), so a direct-path-only suppression would
  /// fail precisely where the control matters most. That is a boolean read in
  /// `findProxyNudgeCandidates`, gated AFTER the child rule and AFTER opt-out — never a
  /// cadence, because retiming the proxy path needs GTC-252's undecided clock decision.
  ///
  /// LAYERED ON TOP OF OPT-OUT, NEVER THROUGH IT (Do-Not-Touch Zone 7). See the NudgeMark
  /// enum docstring.
  ///
  /// NOTHING READS OR WRITES THIS AS OF PHASE 2. The cutover is phase 3, the UI phase 4.
  nudgeMark            NudgeMark?
  /// GTC-189 rulings AG, AH and AL — THE NAMED EXCEPTION to the event-level chase default
  /// on `Event.chaseWhenNoMobileDefault`. Host-set, per person, per event.
  ///
  /// ⚠ READ THE VALUE, NEVER A POLARITY — AND THIS CONTROL'S MEANING INVERTED ON
  /// 2026-09-15. Under ruling AG as first stated, the event default handed people over and
  /// the per-person control meant CHASE THIS ONE. Under ruling AH, later the same day, the
  /// default chases them and the exception means HAND THIS ONE TO ME. Same column, same
  /// screen, opposite meaning — and every sentence written under AG still reads perfectly
  /// well. The founder's one-line check: anything describing this control as "tick to
  /// chase" was written under AG and is now backwards.
  ///
  /// THAT IS WHY THIS IS NOT A BOOLEAN. A boolean can be read either way, so a field
  /// name, a comment or a test label about it would read correctly while meaning the
  /// opposite, and would not announce itself in a diff. This column holds the NAME of a
  /// behaviour — HAND_TO_HOST, or BY_EMAIL — so a read cannot invert.
  ///
  /// NULL MEANS FOLLOW THE EVENT DEFAULT, which under ruling AH is the common case and
  /// most rows. It does NOT mean "never asked": ruling AJ sends the same question to the
  /// mini-send's collapsed one-person pre-flight, so nobody is ever unasked.
  ///
  /// ⚠ AN EARLIER REASON FOR THE SAME NULLABILITY IS STALE, and is recorded rather than
  /// silently rewritten. At ruling AG this column was argued nullable because THREE states
  /// were needed — she ticked, she looked and did not, and she was never asked. Ruling AJ
  /// removed the third. The conclusion survives and its reason does not, which is the
  /// shape GTC-273 and GTC-276 are both about: a right conclusion resting on a wrong
  /// reason.
  ///
  /// ON PersonEvent, NOT Person, for the reason `nudgeMark`'s docstring directly above
  /// argues in full — it is a per-EVENT hosting judgement. The grain is exact:
  /// @@unique([personId, eventId]) below.
  ///
  /// THE NAMED EXCEPTION WINS (ruling AL), in both directions. Where this is set it
  /// decides; where it is NULL the event default decides; where that is NULL the system
  /// default decides. No third case.
  ///
  /// ⚠ THE ADJACENT PAIR'S COMPOSITION RULE IS NOT THIS PAIR'S, and the founder's reason
  /// is the argument rather than just the outcome: `Event.nudgePace` and `nudgeMark`
  /// compose two settings about INTENSITY, where choosing the gentler of two instructions
  /// cannot send a message nobody asked for. This composes a DEFAULT with a DECISION ABOUT
  /// ONE NAMED PERSON, where either answer silently discards something the host said — so
  /// safety cannot pick the winner and the meaning has to. The structural sibling in this
  /// tree is `resolveDecideByOffsetHours` in src/lib/decide-by.ts — per-item, else
  /// per-event, else system — and NOT `resolveNudgeOffsetDays`, which must go on
  /// implementing the intensity axis's rule for the intensity axis.
  ///
  /// `nudgeMark` COMPOSES DOWNSTREAM OF BOTH: a person handed to the host is not chased
  /// whatever the mark says, and a DONT_CHASE person is not chased whatever this says.
  ///
  /// AN OPTED-OUT ROW IS NEVER OFFERED THE EXCEPTION (ruling AI; Do-Not-Touch Zone 7 is
  /// adjacent). Ruling O stands unnarrowed — a no to one channel is a no to being chased.
  ///
  /// NOTHING READS OR WRITES THIS AS OF SLICE 4. The control is GTC-311's, the reader is
  /// slice 8's, and the resolver is its own module rather than a branch inside
  /// nudge-cadence.ts.
  chaseException       ChaseWhenNoMobile?
  householdId          String?
  household            Household?         @relation("HouseholdMembers", fields: [householdId], references: [id])
  householdRole        HouseholdRole?
  /// GTC-172 (C1): DISPLAY ONLY — "captured as a kid with a job". This is NEVER an
  /// input to message eligibility; `householdRole` is the sole gate (Moment 4 §10.6,
  /// absolute). It exists so a young person Kate has DELIBERATELY roled as an adult
  /// still renders in her helpers list instead of silently jumping to the guests list
  /// on reload. Setting this true never grants messageability, and setting it false
  /// never removes it — read it for layout, never for a send decision.
  isYoungPerson        Boolean            @default(false)
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person               Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  proxy                PersonEvent?       @relation("ProxyRelation", fields: [proxyPersonEventId], references: [id])
  householdMembers     PersonEvent[]      @relation("ProxyRelation")
  team                 Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)

  nudgeLogs NudgeLog[]

  /// GTC-189 slice 4: back-relation for `OutboundMessage.personEvent` — every message this
  /// membership has been sent, one row per message. Cascade, by founder decision 28: a row
  /// about a person no longer on the event is worse than a missing row, and slice 6 must
  /// handle an unmatchable bounce anyway, which `SmsDeliveryReport`'s nullability already
  /// assumes.
  outboundMessages OutboundMessage[]

  /// GTC-172 (C1): back-relation for Household.contactPersonEvent — the households
  /// that have picked THIS PersonEvent as their channel. Cross-household by design:
  /// these households need not be this row's own `household`.
  householdsAsContact Household[] @relation("HouseholdContactChannel")

  @@unique([personId, eventId])
}

model Household {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     PersonEvent[] @relation("HouseholdMembers")
  littleCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// GTC-172 (C1): the household contact picker — Moment 4 §10.7. "Who should Gather
  /// talk to for this household?" A reference, never a boolean, and CROSS-HOUSEHOLD
  /// CAPABLE: this may point at a PersonEvent belonging to a DIFFERENT household of
  /// the same event (Grandma's channel lives in her daughter's household).
  ///
  /// NULL means "not picked" and resolves to the household's PRIMARY_CONTACT at read
  /// time — see resolveHouseholdChannel() in src/lib/households/channel.ts. That is
  /// why this ships with no data backfill: the default is computed, not stored.
  ///
  /// A CHILD-role PersonEvent must never be stored here (§10.6). The picker omits
  /// them and the API rejects them, but the eligibility layer re-checks anyway rather
  /// than trusting either.
  contactPersonEventId String?
  contactPersonEvent   PersonEvent? @relation("HouseholdContactChannel", fields: [contactPersonEventId], references: [id], onDelete: SetNull)

  /// GTC-256 (Ruling 6, phase 2): does this household's CHANNEL receive messages?
  /// "The host may be her household's contact, and CHOOSES WHETHER THOSE MESSAGES
  /// SEND." Separate from Ruling 5 by construction: Ruling 5 suppresses her own ask
  /// because of WHAT SHE IS; this is a SETTING SHE CONTROLS about her household.
  ///
  /// NULL MEANS NOT CHOSEN — the convention Event.decideByOffsetHours and
  /// Event.nudgePace already keep. It is not a stored "sends". It resolves to MUTED
  /// for the host's OWN household and to SENDING for every other one, computed at
  /// read time, which is why this ships with NO BACKFILL: every existing household
  /// is NULL and keeps today's behaviour exactly.
  ///
  /// A SEPARATE COLUMN, NOT A THIRD CHANNEL STATE. contactPersonEventId's NULL is
  /// "not picked" and resolves to the PRIMARY_CONTACT (GTC-172, and the no-backfill
  /// property rests on it) — redefining it as "nobody" would silently mute every
  /// household on every existing event. The reference and the sending are two facts,
  /// so they are two columns. resolveHouseholdChannel is unchanged.
  ///
  /// READ IT THROUGH `resolveHouseholdMuted` IN src/lib/households/channel.ts, NEVER
  /// DIRECTLY. A bare `if (h.messagesMuted)` reads NULL as false and un-mutes the
  /// host; a bare `if (h.messagesMuted === false)` misses the host's default. The
  /// resolver also enforces the founder's Ruling-6 safety: a host hosting alone
  /// (Ruling 2) CANNOT switch her household's messages on, whatever is stored —
  /// a household of one has no household messages, only messages about herself.
  ///
  /// SUPPRESSION ONLY, gated in findProxyNudgeCandidates AFTER the child rule
  /// (§10.6, absolute) and AFTER opt-out (Zone 7) — never through either, matching
  /// PersonEvent.nudgeMark and Event.nudgePace.
  messagesMuted Boolean?

  @@index([contactPersonEventId])
}

model Item {
  id                          String              @id @default(cuid())
  name                        String
  /// GTC-171 (B2): the row-kind discriminator. Moment 4 spec §6 — "one assignment
  /// machine, two kinds of rows" (items are owed *to* the day; tasks are owed
  /// *during* it). Task rows are Item rows, so `Assignment` reaches both through
  /// the identical relation, unchanged.
  kind                        RowKind             @default(ITEM)
  quantity                    String?
  description                 String?
  critical                    Boolean             @default(false)
  status                      ItemStatus          @default(UNASSIGNED)
  previouslyAssignedTo        String?
  quantityAmount              Float?
  quantityUnit                QuantityUnit?
  quantityUnitCustom          String?
  quantityText                String?
  quantityState               QuantityState       @default(SPECIFIED)
  quantityLabel               QuantityLabel?
  quantitySource              QuantitySource?
  quantityDerivedFromTemplate Boolean             @default(false)
  placeholderAcknowledged     Boolean             @default(false)
  quantityDeferredTo          QuantityDeferredTo?
  criticalReason              String?
  criticalSource              CriticalSource?
  criticalOverride            CriticalOverride    @default(NONE)
  glutenFree                  Boolean             @default(false)
  dairyFree                   Boolean             @default(false)
  vegetarian                  Boolean             @default(false)
  dietaryTags                 Json?
  equipmentNeeds              Json?
  equipmentLoad               Float?
  durationMinutes             Int?
  notes                       String?
  prepStartTime               String?
  prepEndTime                 String?
  serveTime                   String?
  dropOffAt                   DateTime?
  /// GTC-175 (D2): the per-ITEM decide-by offset override — layer 1, and the one Hinge
  /// §8 names directly ("derived by the system from item logistics and event date, with
  /// Kate able to override per item"). Hours BEFORE neededBy(); NULL falls through to
  /// the event default. See src/lib/decide-by.ts.
  ///
  /// This is an OFFSET, never an instant. A stored decide-by would drift from the
  /// dropOffAt/endDate it was computed from — the Item.status mistake again
  /// (architecture-contract §6). The instant is derived on every read.
  decideByOffsetHours         Int?
  dropOffLocation             String?
  dropOffNote                 String?
  source                      ItemSource          @default(MANUAL)
  generatedBatchId            String?
  isProtected                 Boolean             @default(false)
  lastEditedBy                LastEditedBy?
  aiGenerated                 Boolean             @default(false)
  userConfirmed               Boolean             @default(false)
  teamId                      String
  dayId                       String?
  displayOrder                Int?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  assignment                  Assignment?
  day                         Day?                @relation(fields: [dayId], references: [id])
  team                        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, displayOrder])
}

model Assignment {
  id                     String             @id @default(cuid())
  response               AssignmentResponse @default(PENDING)
  createdAt              DateTime           @default(now())
  /// GTC-175 (D2): the decide-by follow-up sent-stamp. Hinge §8 allows exactly ONE
  /// follow-up near the decide-by; this is the record that it happened.
  ///
  /// WHY PER-ASSIGNMENT. Person.nudge24hSentAt is the shape to avoid — schema.prisma
  /// warns at PersonEvent.rsvpFollowupSentAt that one stamp on Person leaks across
  /// events. A per-PersonEvent stamp would fix that and break something worse: it
  /// cannot honour a per-ITEM offset override, because it has no item. The maybe lives
  /// on this row, so its clock's receipt does too. It dies with the item (onDelete:
  /// Cascade), and a reassignment hands the new holder a NULL stamp — correct, because
  /// the released guest gets a different message entirely (D3 / GTC-176).
  ///
  /// NEVER CLEARED. A guest who goes MAYBE → ACCEPTED → MAYBE inside one window keeps
  /// their stamp and is not texted again. "Exactly one follow-up" then holds literally.
  /// The alternative — clearing on exit from MAYBE — lets one person be texted twice,
  /// and a duplicate text is a trust failure where a missed one is a nuisance. All four
  /// response writers are pinned free of this field by tests/decide-by-clock-test.ts.
  decideByFollowupSentAt DateTime?
  itemId                 String             @unique
  personId               String
  item                   Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  person                 Person             @relation(fields: [personId], references: [id])
}

model InviteEvent {
  id        String          @id @default(cuid())
  eventId   String
  personId  String?
  type      InviteEventType
  metadata  Json?
  createdAt DateTime        @default(now())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person    Person?         @relation(fields: [personId], references: [id])

  @@index([eventId])
  @@index([personId])
  @@index([type])
  @@index([createdAt])
}

/// GTC-264 — where TNZ's delivery results live.
///
/// TNZ answer 200 when they ACCEPT a message and tell us later whether it actually
/// arrived. Before this model the second answer had nowhere to go, so Gather could not
/// tell a delivered message from one that was never delivered at all.
///
/// The recorded wire contract is docs/05_ops/tnz-delivery-status-contract-2026-09-12.md,
/// built from two saved artefacts beside it. Read that before changing anything here.
///
/// WHY A NEW MODEL AND NOT A COLUMN OR AN InviteEventType MEMBER.
///
/// Not columns on InviteEvent: they would be null on seventeen of eighteen types, the
/// SEND path would have to populate providerMessageId (and GTC-264 may read what
/// sendSms writes, never change it), and correcting a row in an append-only event log
/// erases the accept record that GTC-258 needs in order to tell accept-time from
/// delivery-time.
///
/// Not an InviteEventType member: the join key would stay inside InviteEvent.metadata,
/// a Json? column with no index reaching into it, so "queryable by message id" would be
/// a sequential scan over every message ever sent. And naming an enum member commits to
/// a vocabulary — there are twenty-one documented Result values and one of them,
/// Undelivered, still cannot be bucketed without real traffic.
///
/// SMS_SEND_FAILED is NOT overloaded. It is written in exactly one place, the sendSms
/// catch block, and it means a send-time failure. A delivery-time failure is a row here.
/// GTC-189 slice 4 — THE OUTBOUND RECORD. One row per message per recipient.
///
/// WHAT IT IS: an account of a message that was intended, attempted, and then either
/// taken by a provider, refused by one, or withheld by Gather. The press (slice 5) writes
/// one row per recipient inside the same transaction as `Event.sentAt` and the
/// SEND_PRESSED ledger row; a dispatcher on the existing cron pattern drains them; slice
/// 6 and GTC-264's `SmsDeliveryReport` join back on `providerMessageId`.
///
/// ⚠ WHAT IT IS NOT: A STANDING DECISION. Nothing on this row says what Gather should do
/// NEXT time. The host's standing decisions about the chase live on
/// `Event.chaseWhenNoMobileDefault` and `PersonEvent.chaseException` — one per event and
/// one per membership, made before anything is sent, with a different lifetime. Putting
/// either here would make an instruction into a property of a message (ruling AG).
///
/// AND IT DOES NOT HOLD THE WORDS — founder decision 27, RULED 2026-09-18, and ruled
/// rather than inferred from the approved column list. The record says what was sent, to
/// whom, on which channel, and what came back. Not the message body. Two consequences,
/// recorded plainly because they are the price: the pre-flight preview is the only
/// account of what each person was asked, and ruling U's bounce-door "send again"
/// RECOMPOSES from today's plan rather than resending what was sent. If either turns out
/// to matter, a TEXT column is a later migration. `Event.askAuthorLine`'s docstring
/// defers exactly this question here, and this is its answer.
///
/// NOR DELIVERY. This is the SEND side, and acceptance is not delivery — THE PRESS
/// (2026-09-13): "It reports the send on acceptance, not on delivery." TNZ's outcome is
/// `SmsDeliveryReport` (GTC-264); Resend's will be GTC-289's; both join here.
///
/// NOTHING READS OR WRITES THIS AS OF SLICE 4.
model OutboundMessage {
  id String @id @default(cuid())

  /// The event. DENORMALISED — it is derivable through `personEvent` — and kept for three
  /// reasons: every read of this table is per event, the Event cascade gets a direct edge,
  /// and `SmsDeliveryReport` carries the same denormalisation. Founder ruling, 2026-09-18:
  /// written once, at insert, in one transaction, from the same source as `personEventId`.
  /// The counter-argument is ruling C's shape — a stored derivable value is one that can
  /// drift — and it is answered by that single writer rather than dismissed.
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// THE RECIPIENT, AND THE GRAIN. `PersonEvent` is the membership —
  /// @@unique([personId, eventId]) — and it is the row that owns the send clock
  /// (`sentAt`) this message's cadence counts from. Under ruling A2 the host is a
  /// legitimate recipient as a carrier, and she has a `PersonEvent` row, so the grain
  /// needs no exception for her.
  ///
  /// CASCADE, by founder decision 28: a row about a person no longer on the event is
  /// worse than a missing row, and slice 6 must handle an unmatchable bounce anyway —
  /// which `SmsDeliveryReport`'s load-bearing nullability already assumes.
  personEventId String
  personEvent   PersonEvent @relation(fields: [personEventId], references: [id], onDelete: Cascade)

  /// Which message this is. See the `OutboundKind` enum docstring for why the chase legs
  /// are ordinal and never day-named, and for what COORDINATOR_BRIEF is doing here
  /// unwritten.
  kind OutboundKind

  /// EMAIL or TEXT, decided by `chooseAskRoute`/`chooseChaseRoute` at the press and then
  /// stored. See the `OutboundChannel` enum docstring for the spelling and for why it is
  /// an enum.
  channel OutboundChannel

  /// Row creation — the press, or the chase tick that scheduled this leg. The drain's FIFO
  /// order.
  createdAt DateTime @default(now())

  /// THE CLAIM, AND IT IS SET BEFORE THE PROVIDER IS CALLED RATHER THAN AFTER. That is the
  /// whole point of it, and it is the one place this model departs from the house
  /// dispatcher pattern deliberately. `dispatchPendingWrapUpMessages` in src/lib/wrap-up.ts
  /// marks its rows AFTER sending, so a crash between the send and the mark re-sends on
  /// the next tick, and two overlapping cron runs both send. For a wrap-up thank-you that
  /// is a duplicate thank-you. For the press it is a second invitation to everyone in the
  /// window, and the press is ruled ONE ACT, NO RECALL, no undo at the mechanism level
  /// (Hinge §2, ruled gap #1).
  ///
  /// So: claim with `updateMany({ where: { id, attemptedAt: null }, ... })` and send only
  /// when the update count is 1. A double-send is then structurally impossible rather than
  /// merely unlikely, and a row left with `attemptedAt` set and no end state below is a
  /// crashed attempt — a visible fact rather than a silent resend.
  attemptedAt  DateTime?
  attemptCount Int       @default(0)

  /// Backoff. The dispatcher retries a transient failure and never retries a rejection.
  /// ⚠ THE RETRY POLICY IS SLICE 5'S — this is only the storage that policy needs, carried
  /// here rather than in a second migration and a second rehearsal (ruling W's reason).
  ///
  /// ⚠ A RETRY IS NOT A RESEND. A retry is the machine trying the same message again: THIS
  /// row, with `attemptCount` incremented. Ruling U's three bounce-door actions are the
  /// HOST trying again, and each of those is a NEW row.
  nextAttemptAt DateTime?

  /// 'resend', 'tnz' or 'twilio', written at the attempt rather than at the press, because
  /// until the attempt it is an intention and not a fact. A String, not an enum, following
  /// `SmsDeliveryReport.provider` and its stated reason: a second provider should need no
  /// migration.
  provider String?

  /// THE JOIN KEY. Resend's `data.id` for EMAIL; TNZ's `MessageID` for TEXT. The same name
  /// and the same meaning as `SmsDeliveryReport.providerMessageId` — the good kind of
  /// shared word, one question with one answer.
  ///
  /// Nullable, and the nullability is load-bearing rather than defensive. GTC-264 records
  /// that `sendViaTnz` treats a 2xx with an unparseable body as a success and leaves the
  /// id undefined, so a send can be accepted and permanently unjoinable. And the email
  /// half cannot be written at all until slice 4b makes the senders return Resend's id,
  /// which `SendResult` discards today.
  providerMessageId String?

  /// THE PROVIDER TOOK IT. Ruling G: `PersonEvent.sentAt` is stamped from this instant,
  /// per person, so each person's clock starts at their own acceptance rather than at the
  /// press.
  ///
  /// ⚠ THE DUPLICATION IS DELIBERATE AND IS NAMED RATHER THAN LEFT TO BE FOUND. For an ASK
  /// row this instant is the same instant as `PersonEvent.sentAt`, which is therefore
  /// derivable from it. It is kept because the 15-minute cron already selects
  /// `PersonEvent` and must read that clock without a join. Slice 4 does not touch
  /// `sentAt`.
  acceptedAt DateTime?

  /// THE PROVIDER REFUSED IT at submission — slice 5's fourth red at once. `providerError`
  /// carries THEIR words, verbatim and untyped, which is GTC-264 Phase 1's restraint: do
  /// not model a vocabulary you have not observed.
  rejectedAt    DateTime?
  providerError String?

  /// GATHER DID NOT SEND IT. A gate refused the row between the press and the dispatch —
  /// an opt-out arriving in the window, a household switched off, a DONT_CHASE mark set.
  /// `withheldWhy` carries OUR code: a TS union with a `Record` guard so a missing case is
  /// a compile error, exactly as `HostListWhy` and `ChaseNoneWhy` live in
  /// src/lib/eligibility/channel-chooser.ts and the ledger's ~30 actions live behind
  /// `AuditEntry.actionType String`. Whys in this tree are typed in TypeScript and stored
  /// as text.
  ///
  /// ⚠ SEPARATE FROM `providerError` BY RULING AN'S GROUND, AND KEEPING THEM APART IS THE
  /// POINT OF BOTH COLUMNS. "Why would the provider not take it" and "why did Gather not
  /// send it" are two different questions with different true answers for the same row.
  /// One column holding both answers puts a false sentence on a row QUIETLY, because the
  /// code path that produced it was correct for the other question. That is the family
  /// GTC-273 (a detector matching the spelling of a credential rather than evaluating
  /// it), GTC-276 (a detector inheriting the defect the ticket that wrote it had just
  /// named), ruling AN (an ask refusal and a chase refusal sharing SMS_OPTED_OUT) and
  /// ruling AH's measurement (reading an answer's kind and never its channel) all belong
  /// to. Do not collapse them, and do not delete this note when collapsing looks tidy.
  ///
  /// ⚠ QUIET HOURS IS NOT A WITHHOLDING. It DEFERS: the row stays unfinished and the first
  /// run after the window takes it, exactly as the wrap-up dispatcher's deferral is
  /// "implicit and durable — no scheduler, no timer".
  withheldAt  DateTime?
  withheldWhy String?

  /// ⚠ NO @@unique, AND @@unique([personEventId, kind]) IS THE ONE THAT LOOKS RIGHT AND IS
  /// WRONG. It would make the press idempotent at the row level — and then ruling U's
  /// "send again to the same address" and "let the host edit the address and send", each
  /// of which is a new row of the same kind for the same membership, would fail the save.
  /// GTC-264 Phase 1 finding 2's asymmetry applies: a constraint over a lifetime you have
  /// not fully seen turns a wrong belief into silent loss or a hard failure, while an
  /// index turns it into duplicate rows, which are recoverable. The press's idempotency is
  /// the route's refusal of a second press; the dispatcher's is `attemptedAt` above.
  ///
  /// The join slice 6 runs on every inbound bounce.
  @@index([providerMessageId])
  @@index([personEventId])
  @@index([eventId])
  /// THE DRAIN, in the shape of `WrapUpLink`'s @@index([dispatched, createdAt]): the
  /// never-attempted pass reads `attemptedAt IS NULL` in creation order, the retry pass
  /// reads `nextAttemptAt`. A partial index over the unfinished predicate would be better
  /// and is not available — Prisma has no syntax for one, and Do-Not-Touch Zone 5 forbids
  /// hand-editing migration SQL. ⚠ SLICE 5 MUST `EXPLAIN (ANALYZE, BUFFERS)` the real
  /// drain against a table large enough to mean something, the way GTC-264 Phase 1 finding
  /// 3 settled its own storage question by measurement rather than assertion. Index tuning
  /// afterwards is another migration and another rehearsal.
  @@index([attemptedAt, createdAt])
  @@index([nextAttemptAt])
}

model SmsDeliveryReport {
  id String @id @default(cuid())

  /// 'tnz' today. Named rather than assumed so a second SMS provider needs no migration.
  provider String

  /// TNZ's MessageID, echoed back on the delivery webhook. The documented join key, and
  /// the one sendViaTnz has captured on every send since the transport went in.
  /// INDEXED, NOT UNIQUE, and that is deliberate — see the comment on @@index below.
  providerMessageId String

  /// Stored EXACTLY as TNZ sent it, E.164, never normalised. normalizePhoneNumber has
  /// 13 call sites and two test files pinning its behaviour, and GTC-264's instruction is
  /// to report and stop if a delivery report's destination needs the widening. Keeping
  /// the raw string means the question is never asked; the join is on providerMessageId.
  destination String

  /// SUCCESS | FAILED | PENDING on a status report. A string, not an enum: TNZ's own two
  /// documentation pages disagree on case (SUCCESS versus Success), RECEIVED and UPDATED
  /// belong to other callback kinds arriving on the same envelope, and the vocabulary is
  /// documented but not yet observed. Compare case-insensitively.
  status String

  /// One of twenty-one documented values — 'delivered', 'SentOK', 'Bad Number',
  /// 'Destination is blacklisted', and so on. Nullable because whether an absent field
  /// arrives as "" or is omitted entirely is not documented, and the two are worth
  /// telling apart.
  ///
  /// ⚠ Status alone does NOT mean delivery. Two of the four Success values are not
  /// arrivals: 'delivered-to-network' is explicitly not acknowledged by the mobile, and
  /// 'Control Deleted' is an aborted send marked success to avoid retries. Only this
  /// field carries the difference.
  result String?

  /// TNZ's Detail, a key:value string — 'SMSParts:1' for SMS.
  detail String?

  /// TNZ's JobNumber, their internal eight-character handle. Kept because it is what a
  /// TNZ support conversation is keyed on.
  providerJobNumber String?

  /// When TNZ say the MESSAGE WAS SENT, from SentTimeUTC-RFC3339.
  ///
  /// ⚠ NOT when the report was raised. All three timestamps in the payload are send
  /// times; nothing in the envelope carries the report's own clock. That is why
  /// receivedAt exists, and why the acceptance-to-outcome gap (GTC-264 Unknowns 5, which
  /// bears on GTC-258's choice of which stamps move) is measurable only against our side.
  providerSentAt DateTime?

  /// When the report reached us. Our clock, and the row's creation time — they are the
  /// same event, so there is no separate createdAt.
  receivedAt DateTime @default(now())

  /// The exact InviteEvent row for the send, resolved through its metadata.messageId.
  /// A plain column with no relation: this is a provenance pointer into a log, not an
  /// ownership edge, and a back-relation array on InviteEvent would invite traversal.
  inviteEventId String?

  /// Nullable, and the nullability is load-bearing rather than defensive. A report can
  /// arrive for a send that stored no messageId at all, because sendViaTnz treats a 2xx
  /// with an unparseable body as a success and leaves it undefined — GTC-264 must handle
  /// that without throwing, and fixing the send path is GTC-258's. A report can also
  /// arrive for something we never recorded. An unmatched report is recorded, not an error.
  eventId  String?
  personId String?
  event    Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person? @relation(fields: [personId], references: [id])

  /// The query path this model exists for. GTC-264 requires delivery state queryable by
  /// message id, which today is buried in a JSONB column with no index for that path.
  ///
  /// ⚠ NOT @@unique, and the reasoning is the ticket's own ethic. TNZ retry a failed
  /// webhook every five minutes for up to 24 hours, and PENDING-then-SUCCESS appears
  /// possible, so duplicates and multiple reports per message are both expected. A unique
  /// constraint over an unobserved vocabulary turns a wrong belief into SILENT DATA LOSS;
  /// an index turns it into duplicate rows, which are recoverable. Idempotency therefore
  /// lives in the handler, on a natural key, where it is correctable without a migration.
  @@index([providerMessageId])
  @@index([destination])
  @@index([receivedAt])
  @@index([eventId])
  @@index([inviteEventId])
}

