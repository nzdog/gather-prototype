# Prisma Database URL for local development
# For Railway deployment, this is set as an environment variable
DATABASE_URL="postgresql://user@localhost:5432/gather_dev"

# Anthropic API Key for Claude AI integration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Resend API Key for sending magic link emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Email "From" address for transactional emails
# Format: "Name <email@domain.com>"
# Default: "Gather <noreply@gather.app>"
EMAIL_FROM="Gather <noreply@yourdomain.com>"

# Application URL for magic link generation
# Used in email templates to create verification links
# Production: Set to your actual domain (e.g., https://gather.app)
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe API Keys for subscription billing
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Secret for webhook signature verification
# Get this from Stripe Dashboard > Developers > Webhooks
# For local testing: Use `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price ID for your subscription product
# Create a product and price in Stripe Dashboard > Products
# Example: Annual subscription price ID
STRIPE_PRICE_ID="price_1SqhMFIP69tdO3saRJRViz0g"

# SMS Configuration
#
# Two providers, selected per destination by sendSms (src/lib/sms/send-sms.ts):
#   +64 (NZ) and +61 (AU)  -> TNZ
#   everything else        -> Twilio
# Twilio does not deliver to NZ, so TNZ is what actually carries nudges, decide-by
# follow-ups and wrap-up messages for NZ guests.

# SMS via TNZ - REQUIRED for production NZ/AU delivery
# Obtain from the TNZ Dashboard: Users -> API tab -> Auth Token (already base64-encoded)
TNZ_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SMS via Twilio - OPTIONAL, non-NZ/AU destinations only
# Get your credentials from https://www.twilio.com/console
# Note: leaving these unset does NOT disable nudges. Nudge recipients are +64 numbers and
# route to TNZ; only non-NZ/AU destinations need Twilio (GTC-214).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# For development with Twilio test credentials:
# - Use Test Account SID and Auth Token from Twilio Console
# - Test phone numbers won't actually send SMS
# - Useful for testing opt-out logic without real messages

# Cron Job Authentication
# Secret key for authenticating cron job requests (e.g., auto-nudge scheduler)
# Generate a random string: `openssl rand -base64 32`
# This is used by Vercel Cron or other cron services to authenticate requests
CRON_SECRET="your-random-secret-here"
