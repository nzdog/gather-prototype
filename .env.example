# Prisma Database URL for local development
# For Railway deployment, this is set as an environment variable
DATABASE_URL="postgresql://user@localhost:5432/gather_dev"

# Anthropic API Key for Claude AI integration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Resend API Key for sending magic link emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Email "From" address for transactional emails
# Format: "Name <email@domain.com>"
# Default: "Gather <noreply@gather.app>"
EMAIL_FROM="Gather <noreply@yourdomain.com>"

# Unsubscribe token signing secret (GTC-296)
#
# REQUIRED, not optional. Signs the per-event email unsubscribe links every guest-bound
# email carries. Fails closed when unset, following CRON_SECRET's precedent (GTC-270):
# reading a token returns null (404 at the route) and MINTING one throws — so Gather sends
# no guest email at all rather than sending one with no way out of it.
#
# Any long random string. Changing it invalidates every unsubscribe link already in a
# mailbox, so treat it as durable: `openssl rand -base64 48`.
UNSUBSCRIBE_TOKEN_SECRET="change-me-to-a-long-random-string"

# Application URL for magic link generation
# Used in email templates to create verification links
# Production: Set to your actual domain (e.g., https://gather.app)
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe API Keys for subscription billing
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Secret for webhook signature verification
# Get this from Stripe Dashboard > Developers > Webhooks
# For local testing: Use `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price ID for your subscription product
# Create a product and price in Stripe Dashboard > Products
# Example: Annual subscription price ID
STRIPE_PRICE_ID="price_1SqhMFIP69tdO3saRJRViz0g"

# SMS Configuration
#
# Two providers, selected per destination by sendSms (src/lib/sms/send-sms.ts):
#   +64 (NZ) and +61 (AU)  -> TNZ
#   everything else        -> Twilio
# Twilio does not deliver to NZ, so TNZ is what actually carries nudges, decide-by
# follow-ups and wrap-up messages for NZ guests.

# LIVE SENDING (GTC-274) - PRODUCTION ONLY. Leave this commented out here.
# Gather sends a real text or email only where GATHER_LIVE_SENDS is exactly "on". Anywhere
# else every send stops at its last step, whatever keys are set below. Production sets it as
# a Railway variable, and the build refuses a production deploy without it. Never set it in
# .env or .env.local: tests/live-switch-test.ts fails if either file does.
# GATHER_LIVE_SENDS=on

# SMS via TNZ - REQUIRED for production NZ/AU delivery
# Obtain from the TNZ Dashboard: Users -> API tab -> Auth Token (already base64-encoded)
TNZ_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# TNZ webhook credential - REQUIRED wherever TNZ call us (GTC-264, GTC-229)
# TNZ send delivery reports AND replies to one URL, /api/sms/tnz-webhook, and authenticate with
# one identity and one secret set in the TNZ Dashboard: Users -> API User -> API -> Reporting.
# They arrive raw in the X-Sender and Authorization headers and again as Sender and APIKey in the
# body; both places are checked. NOT TNZ_AUTH_TOKEN, which authenticates our calls to them.
# Unset or empty refuses every caller (fails closed, following CRON_SECRET's precedent, GTC-270).
TNZ_CALLBACK_SECRET="the-webhook-APIKey-from-the-TNZ-dashboard"
TNZ_CALLBACK_SENDER="the-webhook-Sender-from-the-TNZ-dashboard"

# SMS via Twilio - OPTIONAL, non-NZ/AU destinations only
# Get your credentials from https://www.twilio.com/console
# Note: leaving these unset does NOT disable nudges. Nudge recipients are +64 numbers and
# route to TNZ; only non-NZ/AU destinations need Twilio (GTC-214).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# For development with Twilio test credentials:
# - Use Test Account SID and Auth Token from Twilio Console
# - Test phone numbers won't actually send SMS
# - Useful for testing opt-out logic without real messages

# Cron Job Authentication
# Secret key for authenticating cron job requests (e.g., auto-nudge scheduler)
# Generate a random string: `openssl rand -base64 32`
# This is used by Vercel Cron or other cron services to authenticate requests
CRON_SECRET="your-random-secret-here"
