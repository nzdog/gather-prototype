{
  "name": "gather-prototype",
  "version": "1.0.0",
  "description": "A coordination app for multi-day gatherings (Christmas, reunions, retreats) that ensures everyone knows what they're responsible for without anyone holding the whole plan in their head.",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx tests/security-validation.ts",
    "test:demo-ui": "tsx tests/demo-ui-isolation.ts",
    "test:conflict-labels": "tsx tests/conflict-action-labels.ts",
    "test:setup-progress-banner": "tsx tests/setup-progress-banner-test.ts",
    "test:setup-modal-header": "tsx tests/setup-modal-header-test.ts",
    "test:demo-endpoints": "tsx tests/demo-endpoints-test.ts",
    "test:participant-null-coordinator": "tsx tests/participant-view-null-coordinator-test.ts",
    "test:coordinator-conflict-detection": "tsx tests/coordinator-conflict-detection-test.ts",
    "test:regen-all-items": "tsx tests/regen-all-items-test.ts",
    "test:url-no-double-slash": "tsx tests/url-no-double-slash-test.ts",
    "test:edit-item-frozen-block": "tsx tests/edit-item-frozen-block-test.ts",
    "test:invite-status-auth": "tsx tests/invite-status-auth-test.ts",
    "test:batch-import-auth": "tsx tests/batch-import-auth-test.ts",
    "test:setup-modal-next-button": "tsx tests/setup-modal-next-button-test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "railway:setup": "prisma migrate deploy && prisma db seed",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.1",
    "lucide-react": "^0.562.0",
    "next": "^15.5.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.7.0",
    "stripe": "^20.2.0",
    "tsx": "^4.21.0",
    "twilio": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/twilio": "^3.19.2",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prisma": "^6.19.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
